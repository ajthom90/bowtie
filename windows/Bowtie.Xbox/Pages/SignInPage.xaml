<Page
    x:Class="BowtieXbox.Pages.SignInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{StaticResource SafeMargin}" XYFocusKeyboardNavigation="Enabled">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="Sign in to Bowtie" Style="{StaticResource TitleText}" />
            <TextBlock x:Name="ServerLabel" Style="{StaticResource BodyText}" Foreground="{StaticResource BowtieMuted}" />
        </StackPanel>

        <!-- Quick sign-in: approve this TV from a phone that's already signed in. -->
        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="16" VerticalAlignment="Center">
            <TextBlock Text="Use your phone" FontSize="30" FontWeight="SemiBold" />
            <Border Width="300" Height="300" Background="White" HorizontalAlignment="Left" Padding="8">
                <Grid>
                    <Image x:Name="QrImage" Stretch="Uniform" />
                    <ProgressRing x:Name="QrSpinner" IsActive="True" Width="48" Height="48" Foreground="#101418" />
                </Grid>
            </Border>
            <TextBlock x:Name="QuickHint" Style="{StaticResource BodyText}" Foreground="{StaticResource BowtieMuted}"
                       Text="Scan the code with a phone that's signed in to Bowtie, or open the link below and enter the code." />
            <TextBlock x:Name="VerifyLabel" Style="{StaticResource BodyText}" IsTextSelectionEnabled="False" />
            <TextBlock x:Name="CodeLabel" FontSize="56" FontWeight="Bold" CharacterSpacing="200"
                       Foreground="{StaticResource BowtieAccent}" />
            <TextBlock x:Name="QuickError" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
            <Button x:Name="QuickRetryButton" Content="Get a new code" Style="{StaticResource TvButton}"
                    Click="OnQuickRetry" Visibility="Collapsed" />
        </StackPanel>

        <!-- Or a username and password (A on a box opens the on-screen keyboard). -->
        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="16" VerticalAlignment="Center">
            <TextBlock Text="Or sign in here" FontSize="30" FontWeight="SemiBold" />
            <TextBox x:Name="UserBox" Style="{StaticResource TvTextBox}" Header="Username"
                     IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
            <PasswordBox x:Name="PasswordInput" FontSize="24" Width="560" HorizontalAlignment="Left"
                         Header="Password" KeyDown="OnPasswordKeyDown" />
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource TvButton}" Click="OnSignIn" />
                <ProgressRing x:Name="Spinner" Width="40" Height="40" />
            </StackPanel>
            <TextBlock x:Name="ErrorLabel" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
            <Button Content="Change server" Style="{StaticResource TvButton}" Click="OnChangeServer" Margin="0,24,0,0" />
        </StackPanel>
    </Grid>
</Page>
