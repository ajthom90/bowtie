<Page
    x:Class="BowtieXbox.Pages.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{StaticResource SafeMargin}" XYFocusKeyboardNavigation="Enabled">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24" MaxWidth="900">
            <TextBlock Text="Bowtie" Style="{StaticResource TitleText}" HorizontalAlignment="Center" />
            <ProgressRing x:Name="Spinner" IsActive="True" Width="64" Height="64" />
            <TextBlock x:Name="StatusText" Style="{StaticResource BodyText}" TextAlignment="Center" />
            <StackPanel x:Name="ErrorButtons" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" Visibility="Collapsed">
                <Button x:Name="RetryButton" Content="Try again" Style="{StaticResource TvButton}" Click="OnRetry" />
                <Button Content="Change server" Style="{StaticResource TvButton}" Click="OnChangeServer" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
