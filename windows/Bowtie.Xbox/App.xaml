<Application
    x:Class="BowtieXbox.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <!-- Replaced at startup with the TV-safe margin (Services/Tv.cs). -->
        <Thickness x:Key="SafeMargin">48,27,48,27</Thickness>
        <SolidColorBrush x:Key="BowtieBackground" Color="#101418" />
        <SolidColorBrush x:Key="BowtieAccent" Color="#4FA3FF" />
        <SolidColorBrush x:Key="BowtieMuted" Color="#A0A8B0" />

        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="40" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Foreground" Value="#FF8A80" />
        </Style>
        <Style x:Key="TvButton" TargetType="Button">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="Padding" Value="24,12" />
        </Style>
        <Style x:Key="TvTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Width" Value="560" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Application.Resources>
</Application>
