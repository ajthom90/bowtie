<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BowtieApp.Pages.ContinueWatchingStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BowtieApp.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Visibility="Collapsed">

    <UserControl.Resources>
        <DataTemplate x:Key="ContinueTemplate" x:DataType="local:ContinueItem">
            <Button Width="220" VerticalAlignment="Stretch" Padding="12,10"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                    Tag="{x:Bind}" Click="OnResumeClick"
                    ToolTipService.ToolTip="{x:Bind ResumeLabel}"
                    AutomationProperties.Name="{x:Bind ResumeLabel}">
                <Button.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Remove from Continue watching" Tag="{x:Bind}"
                                        Click="OnRemoveClick"
                                        AutomationProperties.Name="{x:Bind RemoveLabel}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE711;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.ContextFlyout>
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Subtitle}" Visibility="{x:Bind SubtitleVisibility}" Opacity="0.8"
                               TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" />
                    <ProgressBar Value="{x:Bind Progress}" Maximum="100" Margin="0,4,0,0" />
                    <TextBlock Text="{x:Bind TimeLeft}" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Spacing="8">
        <TextBlock Text="Continue watching" Style="{StaticResource SubtitleTextBlockStyle}" />
        <InfoBar x:Name="MessageBar" IsOpen="False" Severity="Error" IsClosable="True"
                 Closed="OnMessageClosed" />
        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ItemsList" ItemTemplate="{StaticResource ContinueTemplate}"
                          AutomationProperties.Name="Continue watching">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</UserControl>
