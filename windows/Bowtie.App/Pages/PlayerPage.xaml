<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BowtieApp.Pages.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar: back, title, live position, track and quality pickers, full screen. -->
        <Grid x:Name="TopBar" Padding="8" ColumnSpacing="8" Background="{StaticResource BowtieOverlayBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Click="OnBackClick"
                    ToolTipService.ToolTip="Back" AutomationProperties.Name="Back">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Back" Modifiers="None" />
                </Button.KeyboardAccelerators>
                <FontIcon Glyph="&#xE72B;" />
            </Button>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="TitleLabel" Style="{StaticResource SubtitleTextBlockStyle}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Border x:Name="LiveBadge" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                        Background="{StaticResource BowtieLiveBrush}" Visibility="Collapsed">
                    <TextBlock x:Name="LiveBadgeText" Text="LIVE" FontWeight="SemiBold" Foreground="White" />
                </Border>
                <!-- Weak antenna signal (latest heartbeat); live only. Announced when it appears. -->
                <StackPanel x:Name="WeakSignalNote" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{StaticResource BowtieAmberBrush}"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="WeakSignalText" Foreground="{StaticResource BowtieAmberBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="BackSkipButton" Click="OnSkipBackClick"
                        ToolTipService.ToolTip="Back 30 seconds (Left arrow)" AutomationProperties.Name="Back 30 seconds">
                    <FontIcon Glyph="&#xED3C;" />
                </Button>
                <Button x:Name="ForwardSkipButton" Click="OnSkipForwardClick"
                        ToolTipService.ToolTip="Forward 30 seconds (Right arrow)" AutomationProperties.Name="Forward 30 seconds">
                    <FontIcon Glyph="&#xED3D;" />
                </Button>
                <Button x:Name="GoLiveButton" Content="Go Live" Click="OnGoLiveClick" Visibility="Collapsed"
                        Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Jump to live (End)" />
                <ComboBox x:Name="QualityBox" PlaceholderText="Quality" MinWidth="120"
                          SelectionChanged="OnQualityChanged" Visibility="Collapsed"
                          ToolTipService.ToolTip="The most this player will use; it adapts below that to your connection."
                          AutomationProperties.Name="Quality" />
                <DropDownButton x:Name="AudioButton" Visibility="Collapsed"
                                ToolTipService.ToolTip="Audio" AutomationProperties.Name="Audio">
                    <FontIcon Glyph="&#xE8D6;" />
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="AudioMenu" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton x:Name="CaptionsButton" Visibility="Collapsed"
                                ToolTipService.ToolTip="Captions" AutomationProperties.Name="Captions">
                    <FontIcon Glyph="&#xE7F0;" />
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="CaptionsMenu" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton x:Name="SleepButton"
                                ToolTipService.ToolTip="Sleep timer" AutomationProperties.Name="Sleep timer">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE708;" />
                        <TextBlock x:Name="SleepLabel" Text="Sleep" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="SleepMenu" Placement="Bottom" Opening="OnSleepMenuOpening" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="FullScreenButton" Click="OnFullScreenClick"
                        ToolTipService.ToolTip="Full screen (F11)" AutomationProperties.Name="Full screen">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F11" />
                    </Button.KeyboardAccelerators>
                    <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Video with the system transport controls (play/pause, seek bar, volume). -->
        <MediaPlayerElement x:Name="PlayerElement" Grid.Row="1"
                            AreTransportControlsEnabled="True"
                            Stretch="Uniform"
                            DoubleTapped="OnVideoDoubleTapped">
            <MediaPlayerElement.TransportControls>
                <MediaTransportControls IsCompact="False"
                                        IsSeekBarVisible="True" IsSeekEnabled="True"
                                       
                                        IsZoomButtonVisible="False"
                                        IsSkipBackwardButtonVisible="True" IsSkipBackwardEnabled="True"
                                        IsSkipForwardButtonVisible="True" IsSkipForwardEnabled="True"
                                        IsPlaybackRateButtonVisible="False" />
            </MediaPlayerElement.TransportControls>
        </MediaPlayerElement>

        <!-- Skip ad: shown while a recording plays a detected commercial break (S). -->
        <Button x:Name="SkipAdButton" Grid.Row="1" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,120"
                Style="{StaticResource AccentButtonStyle}" Click="OnSkipAdClick"
                ToolTipService.ToolTip="Skip ad (S)" AutomationProperties.Name="Skip ad">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Skip ad" />
                <FontIcon Glyph="&#xEB9D;" FontSize="14" />
            </StackPanel>
        </Button>

        <!-- Status overlay: tuning, buffering, errors, tuners busy. -->
        <Grid x:Name="Overlay" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource BowtieOverlayBrush}">
            <StackPanel MaxWidth="480" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <ProgressRing x:Name="OverlayRing" IsActive="False" Width="40" Height="40" />
                <TextBlock x:Name="OverlayTitle" Style="{StaticResource SubtitleTextBlockStyle}"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="OverlayBody" TextAlignment="Center" TextWrapping="Wrap" Opacity="0.85" />
                <StackPanel x:Name="OverlayButtons" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <Button x:Name="RetryButton" Content="Try again" Click="OnRetryClick"
                            Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="Back to channels" Click="OnBackClick" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Sleep timer's last minute. -->
        <InfoBar x:Name="SleepBar" Grid.Row="1" IsOpen="False" Severity="Informational" IsClosable="False"
                 Title="Sleep timer" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,120">
            <InfoBar.ActionButton>
                <Button Content="Keep watching" Click="OnKeepWatchingClick" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Short notices (jumped to live, skipped ad, etc.). -->
        <InfoBar x:Name="NoticeBar" Grid.Row="1" IsOpen="False" Severity="Informational"
                 VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0" IsClosable="True" />
    </Grid>
</Page>
