<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BowtieApp.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Scrolls when the window is too short to show the whole form. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="420" Margin="24" Spacing="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png"
                   Width="96" Height="96" HorizontalAlignment="Left" />
            <TextBlock Text="Sign in" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="ServerText" Opacity="0.8" TextWrapping="Wrap" />
            <TextBox x:Name="UsernameBox" Header="Username" IsSpellCheckEnabled="False" />
            <PasswordBox x:Name="PasswordInput" Header="Password" KeyDown="OnPasswordKeyDown" />
            <TextBlock x:Name="ErrorLabel" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="SignInButton" Content="Sign in"
                        Style="{StaticResource AccentButtonStyle}" Click="OnSignInClick" />
                <ProgressRing x:Name="Busy" IsActive="False" Width="24" Height="24" />
            </StackPanel>
            <HyperlinkButton Content="Use a different server" Click="OnChangeServerClick" Padding="0" />
        </StackPanel>
    </ScrollViewer>
</Page>
