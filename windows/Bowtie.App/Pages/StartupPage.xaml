<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BowtieApp.Pages.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <StackPanel MaxWidth="420" Margin="24" Spacing="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png"
                   Width="96" Height="96" HorizontalAlignment="Center" />
            <ProgressRing x:Name="Busy" IsActive="True" Width="32" Height="32" />
            <StackPanel x:Name="ErrorPanel" Spacing="12" Visibility="Collapsed">
                <TextBlock x:Name="ErrorLabel" TextWrapping="Wrap" TextAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <Button Content="Try again" Style="{StaticResource AccentButtonStyle}" Click="OnRetryClick" />
                    <Button Content="Use a different server" Click="OnChangeServerClick" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
