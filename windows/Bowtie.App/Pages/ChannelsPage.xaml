<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BowtieApp.Pages.ChannelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BowtieApp.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="ChannelTemplate" x:DataType="local:ChannelItem">
            <Grid ColumnSpacing="4" Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="12,8" Click="OnChannelClick"
                        AutomationProperties.Name="{x:Bind AccessibleName}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="72" Height="40">
                            <Image Source="{x:Bind Logo}" Visibility="{x:Bind LogoVisibility}" Stretch="Uniform" />
                            <TextBlock Text="{x:Bind Number}" Visibility="{x:Bind NumberVisibility}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- The big number is on the left unless a logo replaced it. -->
                                <TextBlock Text="{x:Bind Number}" Opacity="0.7" Visibility="{x:Bind LogoVisibility}" />
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                <TextBlock Text="No signal" Visibility="{x:Bind NoSignalVisibility}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind NowTitle}" TextTrimming="CharacterEllipsis"
                                       Opacity="{x:Bind NowOpacity}" />
                            <ProgressBar Value="{x:Bind Progress}" Maximum="100" MaxWidth="320"
                                         HorizontalAlignment="Left" Width="320"
                                         Visibility="{x:Bind ProgressVisibility}" />
                            <TextBlock Text="{x:Bind NextLine}" Opacity="{x:Bind NextOpacity}" TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock Text="{x:Bind LaterLine}" Visibility="{x:Bind LaterVisibility}"
                                       Foreground="{StaticResource BowtieAmberBrush}" TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button Grid.Column="1" VerticalAlignment="Stretch" Width="48"
                        Visibility="{x:Bind StarVisibility}"
                        Click="OnStarClick"
                        ToolTipService.ToolTip="{x:Bind StarLabel}"
                        AutomationProperties.Name="{x:Bind StarLabel}">
                    <FontIcon Glyph="{x:Bind StarGlyph}" Foreground="{x:Bind StarBrush}" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RecentTemplate" x:DataType="local:RecentItem">
            <!-- MinHeight, not Height: the tile grows to fit both lines at any text size. -->
            <Button Width="140" MinHeight="96" VerticalAlignment="Stretch" Click="OnRecentClick" Padding="8"
                    AutomationProperties.Name="{x:Bind Name}">
                <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Height="40" Visibility="{x:Bind LogoVisibility}">
                        <Image Source="{x:Bind Logo}" Visibility="{x:Bind LogoVisibility}" Stretch="Uniform" />
                    </Grid>
                    <TextBlock Text="{x:Bind Number}" HorizontalAlignment="Center" Opacity="0.7"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind Name}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="24,16,24,8">
            <TextBlock Text="Live TV" Style="{StaticResource TitleTextBlockStyle}" />
            <Button HorizontalAlignment="Right" Click="OnRefreshClick"
                    ToolTipService.ToolTip="Refresh" AutomationProperties.Name="Refresh">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </Button.KeyboardAccelerators>
                <FontIcon Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <!-- Guide category filter (remembered on this PC). -->
        <SelectorBar x:Name="FilterBar" Grid.Row="1" Margin="16,0,16,0" Visibility="Collapsed"
                     SelectionChanged="OnFilterChanged" AutomationProperties.Name="Show programs">
            <SelectorBarItem Text="All" Tag="all" />
            <SelectorBarItem Text="Sports" Tag="sports" />
            <SelectorBarItem Text="Movies" Tag="movies" />
            <SelectorBarItem Text="News" Tag="news" />
            <SelectorBarItem Text="Kids" Tag="kids" />
            <SelectorBarItem Text="New" Tag="new" />
        </SelectorBar>

        <ScrollViewer Grid.Row="2">
            <StackPanel Padding="24,0,24,24" Spacing="8">
                <InfoBar x:Name="MessageBar" IsOpen="False" Severity="Warning" IsClosable="True"
                         Closed="OnMessageClosed" />

                <ProgressRing x:Name="LoadingRing" IsActive="False" HorizontalAlignment="Left" />

                <StackPanel x:Name="FailedPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="FailedLabel" TextWrapping="Wrap" />
                    <Button Content="Try again" Click="OnRefreshClick" />
                </StackPanel>

                <TextBlock x:Name="EmptyLabel" Visibility="Collapsed" TextWrapping="Wrap"
                           Text="No channels yet. An admin can turn channels on in the web app under Admin → Channels." />

                <!-- Part-watched recordings; hides itself when empty. -->
                <local:ContinueWatchingStrip x:Name="ContinueStrip" />

                <StackPanel x:Name="RecentPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="Recent" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource RecentTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <TextBlock x:Name="FavoritesHeader" Text="Favorites" Visibility="Collapsed"
                           Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                <ItemsControl x:Name="FavoritesList" ItemTemplate="{StaticResource ChannelTemplate}" />

                <TextBlock x:Name="AllHeader" Text="All channels" Visibility="Collapsed"
                           Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                <ItemsControl x:Name="OthersList" ItemTemplate="{StaticResource ChannelTemplate}" />

                <StackPanel x:Name="FilterEmptyPanel" Spacing="8" Visibility="Collapsed" Margin="0,24,0,0"
                            HorizontalAlignment="Center">
                    <TextBlock x:Name="FilterEmptyLabel" Opacity="0.7" TextWrapping="Wrap" HorizontalAlignment="Center" />
                    <Button Content="Show all channels" Click="OnShowAllClick" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
