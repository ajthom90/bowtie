<?xml version="1.0" encoding="utf-8" ?>
<component name="ContinueItem" extends="Group">
    <!-- Continue watching card (HomeScene's RowList): title, episode + time
         left, and how far in. -->
    <interface>
        <field id="width" type="float" onChange="onSizeChanged" />
        <field id="height" type="float" onChange="onSizeChanged" />
        <field id="itemContent" type="node" onChange="onItemContent" />
        <field id="focusPercent" type="float" onChange="onFocusChanged" />
        <field id="rowListHasFocus" type="boolean" onChange="onFocusChanged" />
        <field id="rowHasFocus" type="boolean" onChange="onFocusChanged" />
        <field id="itemHasFocus" type="boolean" onChange="onFocusChanged" />
    </interface>
    <script type="text/brightscript" uri="ContinueItem.bs" />
    <children>
        <Rectangle
            id="cardBg"
            width="344"
            height="112"
            color="0x1A2028FF"
        />
        <Label
            id="titleLabel"
            translation="[16, 10]"
            width="312"
            height="40"
            text=""
            horizAlign="left"
            vertAlign="center"
            color="0xF2EFE8FF"
            font="font:MediumBoldSystemFont"
        />
        <Label
            id="detailLabel"
            translation="[16, 52]"
            width="312"
            height="32"
            text=""
            horizAlign="left"
            vertAlign="center"
            color="0x9BA5AEFF"
            font="font:SmallSystemFont"
        />
        <Rectangle
            id="progressTrack"
            translation="[16, 94]"
            width="312"
            height="6"
            color="0x2A323CFF"
        />
        <Rectangle
            id="progressFill"
            translation="[16, 94]"
            width="0"
            height="6"
            color="0xF0A428FF"
        />
    </children>
</component>
