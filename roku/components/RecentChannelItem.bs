' MarkupGrid item for HomeScene's Recent row: number + name on a card.

sub init()
    m.cardBg = m.top.findNode("cardBg")
    m.numberLabel = m.top.findNode("numberLabel")
    m.nameLabel = m.top.findNode("nameLabel")
end sub

sub onItemContent()
    content = m.top.itemContent
    if content = invalid then return
    number = content.guideNumber
    if number = invalid then number = ""
    name = content.title
    if name = invalid then name = ""
    m.numberLabel.text = number
    m.nameLabel.text = name
end sub

sub onSizeChanged()
    w = m.top.width
    h = m.top.height
    if w = invalid or w <= 0 then w = 208
    if h = invalid or h <= 0 then h = 88
    m.cardBg.width = w
    m.cardBg.height = h
    m.numberLabel.width = w - 32
    m.nameLabel.width = w - 32
end sub

sub onFocusChanged()
    ' Focus ring comes from MarkupGrid focusBitmapUri; tint the number like the rail.
    focused = false
    if m.top.gridHasFocus = true and m.top.focusPercent <> invalid and m.top.focusPercent > 0.5
        focused = true
    end if
    if m.top.itemHasFocus = true then focused = true
    if focused
        m.numberLabel.color = "0xF0A428FF"
    else
        m.numberLabel.color = "0xF2EFE8FF"
    end if
end sub
