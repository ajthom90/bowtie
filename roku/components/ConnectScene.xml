<?xml version="1.0" encoding="utf-8" ?>
<component name="ConnectScene" extends="Group">
    <interface>
        <field id="apiTask" type="node" />
        <!-- Set true when /healthz validates and server is persisted. -->
        <field id="connected" type="boolean" alwaysNotify="true" value="false" />
        <!-- PairTask (AppScene owns it): the QR's URL and phone-typed addresses. -->
        <field id="pairTask" type="node" />
    </interface>
    <script type="text/brightscript" uri="ConnectScene.bs" />
    <children>
        <Rectangle
            id="background"
            width="1920"
            height="1080"
            color="0x101418FF"
        />
        <!-- Set up from a phone: shown while the pairing page is listening. -->
        <Group id="pairPanel" visible="false">
            <QrCode id="pairQr" translation="[234, 190]" moduleSize="12" />
            <Label
                id="pairTitleLabel"
                translation="[40, 720]"
                width="880"
                height="40"
                text="Scan with your phone to set up this TV"
                horizAlign="center"
                color="0xF2EFE8FF"
                font="font:MediumBoldSystemFont"
            />
            <Label
                id="pairLinkLabel"
                translation="[20, 772]"
                width="920"
                height="150"
                text=""
                horizAlign="center"
                color="0x9BA5AEFF"
                font="font:SmallSystemFont"
                wrap="true"
            />
        </Group>
        <!-- Shifted right of the QR (x + 480) while the pairing panel shows. -->
        <Group id="formColumn">
            <LayoutGroup
                id="layout"
                translation="[960, 280]"
                layoutDirection="vert"
                horizAlignment="center"
                itemSpacings="[16, 12, 32, 16, 24]"
            >
                <Label
                    id="titleLabel"
                    width="800"
                    height="80"
                    text="Bowtie"
                    horizAlign="center"
                    color="0xF0A428FF"
                    font="font:LargeBoldSystemFont"
                />
                <Label
                    id="subtitleLabel"
                    width="800"
                    height="40"
                    text="Connect to your server"
                    horizAlign="center"
                    color="0xF2EFE8FF"
                    font="font:MediumBoldSystemFont"
                />
                <Label
                    id="hintLabel"
                    width="800"
                    height="100"
                    text="Enter the address of the Bowtie server on your network."
                    horizAlign="center"
                    color="0x9BA5AEFF"
                    font="font:SmallSystemFont"
                    wrap="true"
                />
                <Label
                    id="urlLabel"
                    width="800"
                    height="40"
                    text=""
                    horizAlign="center"
                    color="0xF2EFE8FF"
                    font="font:MediumSystemFont"
                />
                <Label
                    id="errorLabel"
                    width="800"
                    height="100"
                    text=""
                    horizAlign="center"
                    color="0xE05050FF"
                    font="font:SmallSystemFont"
                    wrap="true"
                />
                <Button
                    id="enterButton"
                    text="Type the address instead"
                    minWidth="400"
                    height="60"
                />
            </LayoutGroup>
        </Group>
    </children>
</component>
