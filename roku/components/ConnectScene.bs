' Connect: a QR for setting the TV up from a phone (PairTask serves the page),
' or the address typed with StandardKeyboardDialog; /healthz validates (2s),
' exact error copy. A phone-typed address is probed only while Connect is
' showing; otherwise, or when the probe fails, the phone is told to try again.

import "pkg:/source/lib/Registry.bs"
import "pkg:/source/lib/PairHttp.bs"

' Spec-mandated failure copy (verbatim, Phase 2).
const CONNECT_ERROR = "Couldn't reach a Bowtie server there. Check the address and try again."
const URL_PLACEHOLDER = "https://tv.example.com or http://192.168.1.50:8400"
' The left half's center, where the QR sits; the form shifts right by as much.
const PAIR_COLUMN_X = 480
const PAIR_QR_Y = 190

sub init()
    m.errorLabel = m.top.findNode("errorLabel")
    m.urlLabel = m.top.findNode("urlLabel")
    m.enterButton = m.top.findNode("enterButton")
    m.pairPanel = m.top.findNode("pairPanel")
    m.pairQr = m.top.findNode("pairQr")
    m.pairLinkLabel = m.top.findNode("pairLinkLabel")
    m.formColumn = m.top.findNode("formColumn")
    m.busy = false
    m.fromPair = false
    m.pendingId = ""
    m.pendingBase = ""
    m.urlText = ""
    m.dialog = invalid
    m.observedPair = invalid

    m.enterButton.observeField("buttonSelected", "onEnterButton")
    m.top.observeField("visible", "onVisible")
    m.top.observeField("apiTask", "onApiTaskSet")
    m.top.observeField("pairTask", "onPairTaskSet")
end sub

sub onVisible()
    if m.top.visible = true
        m.errorLabel.text = ""
        m.top.connected = false
        m.enterButton.setFocus(true)
    else
        closeDialog()
        unobserveApi()
        ' The probe's answer won't come now: let a waiting phone try again.
        if m.busy = true and m.fromPair = true then reportPairFailed(m.pendingBase)
        m.busy = false
        m.pendingId = ""
    end if
end sub

sub onApiTaskSet()
    observeApi()
end sub

sub observeApi()
    unobserveApi()
    task = m.top.apiTask
    if task <> invalid
        task.observeFieldScoped("response", "onApiResponse")
        m.observing = true
    end if
end sub

sub unobserveApi()
    if m.observing = true
        task = m.top.apiTask
        if task <> invalid
            task.unobserveFieldScoped("response")
        end if
        m.observing = false
    end if
end sub

' ── Set up from a phone ──────────────────────────────────────────────────────

sub onPairTaskSet()
    if m.observedPair <> invalid
        m.observedPair.unobserveFieldScoped("pairUrl")
        m.observedPair.unobserveFieldScoped("submitted")
    end if
    pair = m.top.pairTask
    m.observedPair = pair
    if pair <> invalid
        pair.observeFieldScoped("pairUrl", "onPairUrl")
        pair.observeFieldScoped("submitted", "onPairSubmitted")
    end if
    onPairUrl()
end sub

' Show (or hide) the QR. Encoding happens only when the URL changes.
sub onPairUrl()
    url = ""
    pair = m.top.pairTask
    if pair <> invalid and pair.pairUrl <> invalid then url = pair.pairUrl
    if url = m.pairQr.text then return

    m.pairQr.text = url
    if url = ""
        m.pairPanel.visible = false
        m.pairLinkLabel.text = ""
        m.formColumn.translation = [0, 0]
        return
    end if
    m.pairLinkLabel.text = "Or open " + url + " on your phone"
    m.pairQr.translation = [PAIR_COLUMN_X - m.pairQr.pixelSize / 2, PAIR_QR_Y]
    m.pairPanel.visible = true
    m.formColumn.translation = [PAIR_COLUMN_X, 0]
end sub

sub onPairSubmitted()
    pair = m.top.pairTask
    if pair = invalid then return
    address = pair.submitted
    if address = invalid or address = "" then return
    ' Only Connect may change the server, and only one probe at a time.
    if m.top.visible <> true or m.busy = true
        reportPairFailed(address)
        return
    end if
    m.urlLabel.text = address
    submitUrl(address, true)
end sub

sub reportPairFailed(address as string)
    pair = m.top.pairTask
    if pair <> invalid then pair.connectFailed = address
end sub

' Connected by typing on the TV: the phone page isn't needed any more.
sub stopPairing()
    pair = m.top.pairTask
    if pair <> invalid then pair.stop = true
end sub

' ── Typing the address ───────────────────────────────────────────────────────

sub onEnterButton()
    if m.busy = true then return
    openUrlKeyboard()
end sub

sub openUrlKeyboard()
    closeDialog()
    dialog = CreateObject("roSGNode", "StandardKeyboardDialog")
    dialog.title = "Server address"
    dialog.message = [URL_PLACEHOLDER]
    dialog.buttons = ["Validate", "Cancel"]
    dialog.keyboardDomain = "alphanumeric"
    if m.urlText <> ""
        dialog.text = m.urlText
    end if
    dialog.observeField("buttonSelected", "onKeyboardButton")
    dialog.observeField("wasClosed", "onKeyboardClosed")
    m.dialog = dialog
    scene = m.top.getScene()
    if scene <> invalid
        scene.dialog = dialog
    end if
end sub

sub onKeyboardButton()
    if m.dialog = invalid then return
    idx = m.dialog.buttonSelected
    text = m.dialog.text
    if text = invalid then text = ""
    m.urlText = text
    m.urlLabel.text = text
    closeDialog()

    if idx = 0
        ' Validate
        submitUrl(text, false)
    end if
    ' Cancel (idx=1) — stay on connect with button focused.
    m.enterButton.setFocus(true)
end sub

sub onKeyboardClosed()
    m.dialog = invalid
    if m.top.visible = true
        m.enterButton.setFocus(true)
    end if
end sub

sub closeDialog()
    if m.dialog <> invalid
        m.dialog.unobserveField("buttonSelected")
        m.dialog.unobserveField("wasClosed")
        m.dialog = invalid
    end if
    scene = m.top.getScene()
    if scene <> invalid and scene.dialog <> invalid
        scene.dialog.close = true
        scene.dialog = invalid
    end if
end sub

' fromPair: the address came from the phone page (PairTask), which hears
' back only when the probe fails.
sub submitUrl(raw as string, fromPair as boolean)
    if m.busy = true then return
    normalized = normalizeServerUrl(raw)
    task = m.top.apiTask
    if normalized = "" or task = invalid
        m.errorLabel.text = CONNECT_ERROR
        if fromPair then reportPairFailed(raw)
        return
    end if

    observeApi()
    m.busy = true
    m.fromPair = fromPair
    m.errorLabel.text = ""
    m.pendingBase = normalized
    m.pendingId = "connect-healthz"
    task.request = {
        id: m.pendingId
        kind: "healthz"
        params: { baseUrl: normalized }
    }
end sub

sub onApiResponse()
    task = m.top.apiTask
    if task = invalid then return
    resp = task.response
    if resp = invalid then return
    if resp.id <> m.pendingId then return

    m.busy = false
    m.pendingId = ""

    ' A phone's address counts only while Connect is still the screen.
    if resp.ok = true and (m.fromPair <> true or m.top.visible = true)
        ' Persist server (clears any stale refresh) and signal AppScene.
        bowtie.registry.save(m.pendingBase, invalid)
        if m.fromPair <> true then stopPairing()
        m.top.connected = true
    else
        m.errorLabel.text = CONNECT_ERROR
        m.enterButton.setFocus(true)
        if m.fromPair = true then reportPairFailed(m.pendingBase)
    end if
end sub

' Same rules as the phone page: trim, default http://, host[:port][/path],
' no trailing slash. "" when it isn't a server address.
function normalizeServerUrl(raw as string) as string
    return bowtie.pair.normalizeServer(raw)
end function
