' Channel rail: MarkupList + ChannelRailItem; channels+guide via ApiTask;
' join with bowtie.guide.nowNext; refresh on show + 5-min timer.
' Favorites float to the top (bowtie.favorites). * on a rail item opens a
' dialog: Favorite/Unfavorite (optimistic toggle), Record this program (when
' the guide has a current program; 409 → conflicts + Record anyway), Record
' series (POST /recording-rules → "Scheduled N episodes"), Cancel.
' A Recent row (recentList) sits above the rail when the server has watch
' history. Focus: [Recordings | Settings] <-> recentList <-> rail.

import "pkg:/source/lib/GuideLogic.bs"
import "pkg:/source/lib/Favorites.bs"
import "pkg:/source/lib/Recordings.bs"

const EMPTY_COPY = "No channels yet. Ask your admin to enable some."
const GUIDE_WINDOW_SECS = 4 * 3600
const RECENTS_LIMIT = 8
' Rail placement without / with the Recent row above it.
const RAIL_Y = 160
const RAIL_ROWS = 7
const RAIL_Y_WITH_RECENTS = 280
const RAIL_ROWS_WITH_RECENTS = 6

sub init()
    m.titleLabel = m.top.findNode("titleLabel")
    m.userLabel = m.top.findNode("userLabel")
    m.settingsButton = m.top.findNode("settingsButton")
    m.recordingsButton = m.top.findNode("recordingsButton")
    m.loadingGroup = m.top.findNode("loadingGroup")
    m.loadingSpinner = m.top.findNode("loadingSpinner")
    m.emptyLabel = m.top.findNode("emptyLabel")
    m.errorGroup = m.top.findNode("errorGroup")
    m.errorLabel = m.top.findNode("errorLabel")
    m.retryButton = m.top.findNode("retryButton")
    m.channelList = m.top.findNode("channelList")
    m.recentLabel = m.top.findNode("recentLabel")
    m.recentList = m.top.findNode("recentList")
    m.refreshTimer = m.top.findNode("refreshTimer")

    m.observing = false
    m.loadGen = 0
    m.pendingChannelsId = ""
    m.pendingGuideId = ""
    m.pendingRecentsId = ""
    ' In-flight star toggles: request id -> {channelId, on}.
    m.pendingFavs = {}
    m.favSeq = 0
    ' bowtie.favorites state; m.channels is always m.fav.channels (the rail).
    m.fav = invalid
    m.channels = []
    m.guideById = {}
    m.recents = []
    m.busy = false
    m.lastLoadedAt = 0
    ' * dialog: menu shown, and the channel + current program it acts on.
    m.dialog = invalid
    m.dialogMode = ""
    m.menu = []
    m.optionsChannelId = invalid
    m.optionsProgram = invalid
    ' In-flight createRecording / createRecordingRule: {id, channelId, program, series}.
    m.pendingRecord = invalid
    m.recSeq = 0
    ' Header button Up from the rail returns to (Recordings until one is left).
    m.headerButton = invalid

    m.settingsButton.observeField("buttonSelected", "onSettingsButton")
    m.recordingsButton.observeField("buttonSelected", "onRecordingsButton")
    m.retryButton.observeField("buttonSelected", "onRetryButton")
    m.channelList.observeField("itemSelected", "onItemSelected")
    m.recentList.observeField("itemSelected", "onRecentSelected")
    m.refreshTimer.observeField("fire", "onRefreshTimer")
    m.top.observeField("visible", "onVisible")
    m.top.observeField("apiTask", "onApiTaskSet")
end sub

sub onApiTaskSet()
    observeApi()
end sub

sub observeApi()
    unobserveApi()
    task = m.top.apiTask
    if task <> invalid
        task.observeFieldScoped("response", "onApiResponse")
        m.observing = true
    end if
end sub

sub unobserveApi()
    if m.observing = true
        task = m.top.apiTask
        if task <> invalid
            task.unobserveFieldScoped("response")
        end if
        m.observing = false
    end if
end sub

sub onVisible()
    if m.top.visible = true
        m.top.openSettings = false
        m.top.openRecordings = false
        m.top.selectedChannel = invalid
        updateUserLabel()
        observeApi()
        startRefreshTimer()
        ' Full refresh on every show (Task 4: refresh on show).
        loadChannels()
    else
        stopRefreshTimer()
        closeDialog()
        m.pendingRecord = invalid
        unobserveApi()
        setLoading(false)
    end if
end sub

sub updateUserLabel()
    uname = ""
    task = m.top.apiTask
    if task <> invalid and task.user <> invalid and task.user.username <> invalid
        uname = task.user.username
    end if
    m.userLabel.text = uname
end sub

sub startRefreshTimer()
    m.refreshTimer.control = "stop"
    m.refreshTimer.control = "start"
end sub

sub stopRefreshTimer()
    m.refreshTimer.control = "stop"
end sub

sub onRefreshTimer()
    if m.top.visible <> true then return
    if m.busy = true then return
    ' A reload moves focus; wait until the * dialog is gone.
    if m.dialog <> invalid then return
    ' Stale if never loaded or ≥ 5 minutes since last success.
    nowSecs = nowAsSeconds()
    if m.lastLoadedAt = 0 or (nowSecs - m.lastLoadedAt) >= 300
        loadChannels()
    end if
end sub

sub onSettingsButton()
    m.top.openSettings = true
end sub

sub onRecordingsButton()
    m.top.openRecordings = true
end sub

sub onRetryButton()
    loadChannels()
end sub

sub onItemSelected()
    selectChannelAt(m.channelList.itemSelected)
end sub

sub onRecentSelected()
    idx = m.recentList.itemSelected
    if idx = invalid or idx < 0 or idx >= m.recents.count() then return
    ' Play from the rail so up/down zapping continues in rail order.
    selectChannelAt(bowtie.favorites.indexOfChannel(m.channels, m.recents[idx].channelId))
end sub

sub selectChannelAt(idx as dynamic)
    if idx = invalid or idx < 0 then return
    if m.channels = invalid or idx >= m.channels.count() then return
    ch = m.channels[idx]
    if ch = invalid then return
    ' Player needs full rail for up/down zap + index for wrap.
    m.top.selectedChannel = {
        id: ch.id
        guideNumber: ch.guideNumber
        name: ch.name
        index: idx
        channels: m.channels
    }
end sub

' Focus chain [Recordings | Settings] <-> recentList <-> rail, and * for the
' focused rail item's dialog. Only rail focus takes *; PlayerScene is a
' sibling, so its keys (where * belongs to the system menu) never reach here.
function onKeyEvent(key as string, press as boolean) as boolean
    if press <> true then return false

    if m.channelList.hasFocus()
        if key = "options"
            return openChannelOptions()
        end if
        ' MarkupList lets "up" through only from its first item.
        if key = "up"
            if m.recentList.visible = true
                m.recentList.setFocus(true)
            else
                focusHeader()
            end if
            return true
        end if
        return false
    end if

    if m.recentList.hasFocus()
        if key = "down" and m.channelList.visible = true
            m.channelList.setFocus(true)
            return true
        end if
        if key = "up"
            focusHeader()
            return true
        end if
        return false
    end if

    ' Header row: Recordings and Settings side by side.
    if m.recordingsButton.hasFocus() or m.settingsButton.hasFocus()
        if key = "right" and m.recordingsButton.hasFocus()
            m.settingsButton.setFocus(true)
            return true
        end if
        if key = "left" and m.settingsButton.hasFocus()
            m.recordingsButton.setFocus(true)
            return true
        end if
        if key = "down"
            m.headerButton = m.recordingsButton
            if m.settingsButton.hasFocus() then m.headerButton = m.settingsButton
            if m.recentList.visible = true
                m.recentList.setFocus(true)
                return true
            end if
            if m.channelList.visible = true
                m.channelList.setFocus(true)
                return true
            end if
        end if
    end if

    return false
end function

' Back up to the header button last left from (Recordings at first).
sub focusHeader()
    if m.headerButton = invalid then m.headerButton = m.recordingsButton
    m.headerButton.setFocus(true)
end sub

' ── * dialog ─────────────────────────────────────────────────────────────────

' Favorite/Unfavorite, Record this program (only with a current program in
' the guide already loaded), Cancel. The channel and program are captured
' now: the dialog takes focus and the rail may re-sort under it.
function openChannelOptions() as boolean
    idx = m.channelList.itemFocused
    if m.fav = invalid or idx = invalid or idx < 0 or idx >= m.channels.count() then return false
    ch = m.channels[idx]
    programs = m.guideById[ch.id.toStr()]
    if programs = invalid then programs = []
    nowProgram = bowtie.guide.nowNext(programs, isoNow()).now
    opts = bowtie.recordings.homeOptions(m.fav.supported, ch.favorite = true, nowProgram)
    ' Only Cancel (no favorites, nothing on now): nothing to offer.
    if opts.buttons.count() <= 1 then return false

    m.optionsChannelId = ch.id
    m.optionsProgram = nowProgram
    m.menu = opts.buttons
    message = []
    if opts.note <> "" then message.push(opts.note)
    showDialog("channel", ch.guideNumber + "  " + ch.name, message, bowtie.recordings.buttonLabels(opts.buttons))
    return true
end function

sub onDialogButton()
    if m.dialog = invalid then return
    idx = m.dialog.buttonSelected
    mode = m.dialogMode
    menu = m.menu
    closeDialog()
    restoreRailFocus()

    if mode = "channel"
        choice = bowtie.recordings.buttonId(menu, idx)
        if choice = "favorite"
            toggleFavorite(m.optionsChannelId)
        else if choice = "record"
            sendRecord(m.optionsChannelId, m.optionsProgram, false)
        else if choice = "series"
            sendSeries(m.optionsChannelId, m.optionsProgram)
        end if
    else if mode = "conflict"
        ' Record anyway: lower priority; earlier recordings keep their tuners.
        if idx = 0 then sendRecord(m.optionsChannelId, m.optionsProgram, true)
    end if
end sub

' Optimistic: flip the star, re-sort in place (no reload: that would show the
' spinner and drop focus), keep focus on the same channel, then PUT/DELETE.
function toggleFavorite(channelId as dynamic) as boolean
    if m.fav = invalid or channelId = invalid then return false
    result = bowtie.favorites.toggle(m.fav, channelId)
    if result = invalid then return false
    m.channels = m.fav.channels
    renderRail(channelId)
    sendFavorite(channelId, result.on)
    return true
end function

' POST /recordings for the program by its exact guide start (the server
' matches it exactly). force = Record anyway after a 409.
sub sendRecord(channelId as dynamic, program as dynamic, force as boolean)
    task = m.top.apiTask
    if task = invalid or channelId = invalid or program = invalid or program.start = invalid then return
    m.recSeq = m.recSeq + 1
    reqId = "home-record-" + m.recSeq.toStr()
    m.pendingRecord = { id: reqId, channelId: channelId, program: program, series: false }
    task.request = {
        id: reqId
        kind: "createRecording"
        params: { channelId: channelId, programStart: program.start, force: force }
    }
end sub

' POST /recording-rules from the current program: this channel, new episodes
' only (the server's defaults). It schedules the upcoming airings at once.
sub sendSeries(channelId as dynamic, program as dynamic)
    task = m.top.apiTask
    if task = invalid or channelId = invalid or program = invalid or program.start = invalid then return
    m.recSeq = m.recSeq + 1
    reqId = "home-series-" + m.recSeq.toStr()
    m.pendingRecord = { id: reqId, channelId: channelId, program: program, series: true }
    task.request = {
        id: reqId
        kind: "createRecordingRule"
        params: { channelId: channelId, programStart: program.start }
    }
end sub

sub handleSeriesResponse(resp as object)
    m.pendingRecord = invalid
    if resp.ok = true
        ' "Scheduled N episodes." The next guide refresh brings their marks.
        showDialog("info", "Recording series", bowtie.recordings.seriesScheduledMessage(resp.data), ["OK"])
        return
    end if
    showDialog("info", "Can't record series", [bowtie.recordings.seriesErrorText(resp.error)], ["OK"])
end sub

sub handleRecordResponse(resp as object)
    pending = m.pendingRecord
    m.pendingRecord = invalid
    if resp.ok = true
        ' Mark the program (shared with m.guideById) so * no longer offers
        ' Record until the next guide refresh brings the server's mark.
        rec = invalid
        if resp.data <> invalid then rec = resp.data.recording
        if rec <> invalid and pending.program <> invalid
            pending.program.recording = { id: rec.id, state: rec.state }
        end if
        showDialog("info", "Recording scheduled", bowtie.recordings.scheduledMessage(resp.data), ["OK"])
        return
    end if

    err = resp.error
    code = 0
    if err <> invalid and err.code <> invalid then code = err.code
    if code = 409
        m.optionsChannelId = pending.channelId
        m.optionsProgram = pending.program
        showDialog("conflict", "Not enough tuners", bowtie.recordings.conflictMessage(err, localUtcOffset()), ["Record anyway", "Cancel"])
        return
    end if
    msg = "Couldn't schedule the recording."
    if code = 404
        msg = "That program isn't in the guide anymore."
    else if code = 503
        msg = "Recording isn't available on this server."
    else if err <> invalid and err.message <> invalid and err.message <> ""
        msg = err.message
    end if
    showDialog("info", "Can't record", [msg], ["OK"])
end sub

sub showDialog(mode as string, title as string, message as object, buttons as object)
    closeDialog()
    m.dialogMode = mode
    dialog = CreateObject("roSGNode", "StandardMessageDialog")
    dialog.title = title
    dialog.message = message
    dialog.buttons = buttons
    dialog.observeField("buttonSelected", "onDialogButton")
    dialog.observeField("wasClosed", "onDialogClosed")
    m.dialog = dialog
    scene = m.top.getScene()
    if scene <> invalid then scene.dialog = dialog
end sub

sub onDialogClosed()
    m.dialog = invalid
    m.dialogMode = ""
    if m.top.visible = true then restoreRailFocus()
end sub

sub closeDialog()
    if m.dialog <> invalid
        m.dialog.unobserveField("buttonSelected")
        m.dialog.unobserveField("wasClosed")
        m.dialog = invalid
    end if
    m.dialogMode = ""
    scene = m.top.getScene()
    if scene <> invalid and scene.dialog <> invalid
        scene.dialog.close = true
        scene.dialog = invalid
    end if
end sub

sub restoreRailFocus()
    if m.channelList.visible = true
        m.channelList.setFocus(true)
    else
        focusHeader()
    end if
end sub

' Local = UTC + this. GetTimeZoneOffset is minutes from local to UTC (CDT → 300).
function localUtcOffset() as integer
    dt = CreateObject("roDateTime")
    return -dt.GetTimeZoneOffset() * 60
end function

sub sendFavorite(channelId as dynamic, on as boolean)
    task = m.top.apiTask
    if task = invalid then return
    m.favSeq = m.favSeq + 1
    reqId = "home-fav-" + m.favSeq.toStr()
    m.pendingFavs[reqId] = { channelId: channelId, on: on }
    task.request = {
        id: reqId
        kind: "setFavorite"
        params: { channelId: channelId, on: on }
    }
end sub

sub handleFavoriteResponse(resp as object)
    pending = m.pendingFavs[resp.id]
    m.pendingFavs.Delete(resp.id)
    if m.fav = invalid then return
    ' Remember the focused channel; a revert can move it.
    focusedId = invalid
    idx = m.channelList.itemFocused
    if idx <> invalid and idx >= 0 and idx < m.channels.count() then focusedId = m.channels[idx].id
    if bowtie.favorites.resolve(m.fav, pending.channelId, pending.on, resp.ok = true)
        m.channels = m.fav.channels
        renderRail(focusedId)
    end if
end sub

sub loadChannels()
    task = m.top.apiTask
    if task = invalid then return

    m.loadGen = m.loadGen + 1
    gen = m.loadGen
    m.busy = true
    m.pendingChannelsId = "home-channels-" + gen.toStr()
    m.pendingGuideId = ""
    m.pendingRecentsId = ""
    ' The reload is queued behind any PUT/DELETE, so it returns server truth.
    m.pendingFavs = {}
    showLoading()

    task.request = {
        id: m.pendingChannelsId
        kind: "channels"
        params: {}
    }
end sub

sub loadGuide()
    task = m.top.apiTask
    if task = invalid then return

    gen = m.loadGen
    m.pendingGuideId = "home-guide-" + gen.toStr()
    window = guideWindow()
    task.request = {
        id: m.pendingGuideId
        kind: "guide"
        params: {
            start: window.start
            stop: window.stop
        }
    }
end sub

sub loadRecents()
    task = m.top.apiTask
    if task = invalid then return
    m.pendingRecentsId = "home-recents-" + m.loadGen.toStr()
    task.request = {
        id: m.pendingRecentsId
        kind: "recents"
        params: { limit: RECENTS_LIMIT }
    }
end sub

sub onApiResponse()
    task = m.top.apiTask
    if task = invalid then return
    if m.top.visible <> true then return
    resp = task.response
    if resp = invalid then return

    if resp.id = m.pendingChannelsId
        handleChannelsResponse(resp)
        return
    end if
    if resp.id = m.pendingGuideId and m.pendingGuideId <> ""
        handleGuideResponse(resp)
        return
    end if
    if resp.id = m.pendingRecentsId and m.pendingRecentsId <> ""
        handleRecentsResponse(resp)
        return
    end if
    if resp.id <> invalid and m.pendingFavs.DoesExist(resp.id)
        handleFavoriteResponse(resp)
        return
    end if
    if m.pendingRecord <> invalid and resp.id = m.pendingRecord.id
        if m.pendingRecord.series = true
            handleSeriesResponse(resp)
        else
            handleRecordResponse(resp)
        end if
        return
    end if
end sub

sub handleChannelsResponse(resp as object)
    m.pendingChannelsId = ""
    if resp.ok <> true
        m.busy = false
        showError(errorMessage(resp))
        return
    end if

    ' API may return a bare array or {channels: [...]}; favorites first.
    m.fav = bowtie.favorites.newState(resp.data)
    m.channels = m.fav.channels
    m.recents = []

    if m.channels.count() = 0
        m.busy = false
        m.lastLoadedAt = nowAsSeconds()
        showEmpty()
        return
    end if

    ' Recents first (ApiTask is FIFO), so the row is ready when the guide
    ' response shows the rail and both paint together. An older server
    ' without favorites has no /me/recents either.
    if m.fav.supported then loadRecents()
    ' Fetch guide for now/next join.
    loadGuide()
end sub

sub handleGuideResponse(resp as object)
    m.pendingGuideId = ""
    m.busy = false
    m.lastLoadedAt = nowAsSeconds()

    m.guideById = {}
    if resp.ok = true and resp.data <> invalid
        m.guideById = indexGuide(resp.data)
    end if

    renderRail(invalid)
    showList()
end sub

sub handleRecentsResponse(resp as object)
    m.pendingRecentsId = ""
    ' Any error (404 from a server without recents included) hides the row.
    recents = []
    if resp.ok = true
        for each r in bowtie.favorites.parseRecents(resp.data)
            ' Only channels on the rail: selecting one plays from the rail.
            if bowtie.favorites.indexOfChannel(m.channels, r.channelId) >= 0 then recents.push(r)
        end for
    end if
    m.recents = recents
    updateRecentsRow()
end sub

' Rebuild the rail from m.channels and the last guide; keep focus on
' focusChannelId when given (its index changes when favorites re-sort).
sub renderRail(focusChannelId as dynamic)
    m.channelList.content = buildListContent(m.channels, m.guideById, isoNow())
    if focusChannelId <> invalid
        idx = bowtie.favorites.indexOfChannel(m.channels, focusChannelId)
        if idx >= 0 then m.channelList.jumpToItem = idx
    end if
end sub

' Show the Recent row only beside a visible rail with history; the rail
' shifts down and loses a row to make room.
sub updateRecentsRow()
    show = (m.channelList.visible = true and m.recents.count() > 0)
    if show
        root = CreateObject("roSGNode", "ContentNode")
        for each r in m.recents
            item = root.createChild("ContentNode")
            item.title = r.name
            item.addFields({ guideNumber: r.guideNumber, channelId: r.channelId })
        end for
        m.recentList.content = root
        m.channelList.translation = [80, RAIL_Y_WITH_RECENTS]
        m.channelList.numRows = RAIL_ROWS_WITH_RECENTS
    else
        if m.recentList.hasFocus() and m.channelList.visible = true
            m.channelList.setFocus(true)
        end if
        m.channelList.translation = [80, RAIL_Y]
        m.channelList.numRows = RAIL_ROWS
    end if
    m.recentLabel.visible = show
    m.recentList.visible = show
end sub

function indexGuide(data as object) as object
    byId = {}
    list = data
    if type(data) <> "roArray"
        if data.channels <> invalid
            list = data.channels
        else
            return byId
        end if
    end if
    for each gc in list
        if gc <> invalid and gc.channelId <> invalid
            key = gc.channelId.toStr()
            programs = gc.programs
            if programs = invalid then programs = []
            byId[key] = programs
        end if
    end for
    return byId
end function

function buildListContent(channels as object, guideById as object, atIso as string) as object
    root = CreateObject("roSGNode", "ContentNode")
    for each ch in channels
        key = ch.id.toStr()
        programs = guideById[key]
        if programs = invalid then programs = []
        nn = bowtie.guide.nowNext(programs, atIso)
        nowTitle = ""
        nextTitle = ""
        progress = 0.0
        if nn.now <> invalid
            if nn.now.title <> invalid then nowTitle = nn.now.title
            progress = programProgress(nn.now, atIso)
        end if
        if nn.next <> invalid and nn.next.title <> invalid
            nextTitle = nn.next.title
        end if

        item = root.createChild("ContentNode")
        item.title = ch.name
        item.addFields({
            guideNumber: ch.guideNumber
            channelId: ch.id
            nowTitle: nowTitle
            nextTitle: nextTitle
            progress: progress
            favorite: ch.favorite
            rowKind: "channel"
        })
    end for
    return root
end function

function programProgress(program as object, atIso as string) as float
    if program = invalid then return 0.0
    if program.start = invalid or program.stop = invalid then return 0.0
    startSecs = isoToSeconds(program.start)
    stopSecs = isoToSeconds(program.stop)
    atSecs = isoToSeconds(atIso)
    total = stopSecs - startSecs
    if total <= 0 then return 0.0
    elapsed = atSecs - startSecs
    p = elapsed / total
    if p < 0 then p = 0
    if p > 1 then p = 1
    return p
end function

function guideWindow() as object
    dt = CreateObject("roDateTime")
    dt.Mark() ' roDateTime stays UTC unless ToLocalTime() is called
    startIso = dt.ToISOString()
    secs = dt.AsSeconds() + GUIDE_WINDOW_SECS
    dt.FromSeconds(secs)
    stopIso = dt.ToISOString()
    return { start: startIso, stop: stopIso }
end function

function isoNow() as string
    dt = CreateObject("roDateTime")
    dt.Mark()
    return dt.ToISOString()
end function

function isoToSeconds(iso as string) as integer
    if iso = invalid or iso = "" then return 0
    dt = CreateObject("roDateTime")
    dt.FromISO8601String(iso)
    return dt.AsSeconds()
end function

function nowAsSeconds() as integer
    dt = CreateObject("roDateTime")
    dt.Mark()
    return dt.AsSeconds()
end function

function errorMessage(resp as object) as string
    if resp = invalid then return "Couldn't load channels."
    if resp.error <> invalid
        msg = resp.error.message
        if msg <> invalid and msg <> "" then return msg
    end if
    return "Couldn't load channels."
end function

sub showLoading()
    m.loadingGroup.visible = true
    if m.loadingSpinner <> invalid
        m.loadingSpinner.control = "start"
    end if
    m.emptyLabel.visible = false
    m.errorGroup.visible = false
    m.channelList.visible = false
    m.settingsButton.setFocus(true)
    updateRecentsRow()
end sub

sub showEmpty()
    setLoading(false)
    m.emptyLabel.text = EMPTY_COPY
    m.emptyLabel.visible = true
    m.errorGroup.visible = false
    m.channelList.visible = false
    m.settingsButton.setFocus(true)
    updateRecentsRow()
end sub

sub showError(message as string)
    setLoading(false)
    m.emptyLabel.visible = false
    m.errorGroup.visible = true
    m.errorLabel.text = message
    m.channelList.visible = false
    m.retryButton.setFocus(true)
    updateRecentsRow()
end sub

sub showList()
    setLoading(false)
    m.emptyLabel.visible = false
    m.errorGroup.visible = false
    m.channelList.visible = true
    updateRecentsRow()
    m.channelList.setFocus(true)
end sub

sub setLoading(on as boolean)
    m.loadingGroup.visible = on
    if m.loadingSpinner <> invalid
        if on
            m.loadingSpinner.control = "start"
        else
            m.loadingSpinner.control = "stop"
        end if
    end if
end sub
