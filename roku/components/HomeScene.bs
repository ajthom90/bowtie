' Channel rail: MarkupList + ChannelRailItem; channels+guide via ApiTask;
' join with bowtie.guide.nowNext; refresh on show + 5-min timer.
' Favorites float to the top (bowtie.favorites). * on a rail item opens a
' dialog: Favorite/Unfavorite (optimistic toggle), Record this program (when
' the guide has a current program; 409 → conflicts + Record anyway), Record
' series (POST /recording-rules → "Scheduled N episodes"), Cancel.
' A Recent row (recentList) sits above the rail when the server has watch
' history, and a Continue watching row (continueList: part-watched
' recordings, bowtie.continueWatching) above that when there are any.
' OK on a Continue item resumes it (resumeRecording -> AppScene ->
' RecordingsScene plays it from its saved position, then comes back here,
' which reloads everything); * offers Remove from Continue watching
' (PUT position 0).
' Guide filter chips (filterList: All · Sports · Movies · News · Kids · New,
' bowtie.guideFilter) sit directly above the rail: the rail (m.railChannels)
' keeps only the channels whose now/next matches; when none do, "No sports
' on right now" and Show all take its place. The chip is kept in the
' registry (bowtie.registry guideFilter). The player still zaps the full
' rail (m.channels).
' Focus: [Recordings | Settings] <-> continueList <-> recentList <->
' filterList <-> rail | Show all (hidden rows are skipped). Row placement:
' bowtie.continueWatching.homeLayout.

import "pkg:/source/lib/GuideLogic.bs"
import "pkg:/source/lib/GuideFilter.bs"
import "pkg:/source/lib/Favorites.bs"
import "pkg:/source/lib/Recordings.bs"
import "pkg:/source/lib/ContinueWatching.bs"
import "pkg:/source/lib/Registry.bs"

const EMPTY_COPY = "No channels yet. Ask your admin to enable some."
const GUIDE_WINDOW_SECS = 4 * 3600
const RECENTS_LIMIT = 8

sub init()
    m.titleLabel = m.top.findNode("titleLabel")
    m.userLabel = m.top.findNode("userLabel")
    m.settingsButton = m.top.findNode("settingsButton")
    m.recordingsButton = m.top.findNode("recordingsButton")
    m.loadingGroup = m.top.findNode("loadingGroup")
    m.loadingSpinner = m.top.findNode("loadingSpinner")
    m.emptyLabel = m.top.findNode("emptyLabel")
    m.errorGroup = m.top.findNode("errorGroup")
    m.errorLabel = m.top.findNode("errorLabel")
    m.retryButton = m.top.findNode("retryButton")
    m.channelList = m.top.findNode("channelList")
    m.recentLabel = m.top.findNode("recentLabel")
    m.recentList = m.top.findNode("recentList")
    m.continueLabel = m.top.findNode("continueLabel")
    m.continueList = m.top.findNode("continueList")
    m.filterList = m.top.findNode("filterList")
    m.filterEmptyGroup = m.top.findNode("filterEmptyGroup")
    m.filterEmptyLabel = m.top.findNode("filterEmptyLabel")
    m.showAllButton = m.top.findNode("showAllButton")
    m.refreshTimer = m.top.findNode("refreshTimer")

    m.observing = false
    m.loadGen = 0
    m.pendingChannelsId = ""
    m.pendingGuideId = ""
    m.pendingRecentsId = ""
    m.pendingContinueId = ""
    ' In-flight star toggles: request id -> {channelId, on}.
    m.pendingFavs = {}
    m.favSeq = 0
    ' bowtie.favorites state; m.channels is always m.fav.channels (every
    ' channel, favorites first: the player zaps through it).
    m.fav = invalid
    m.channels = []
    ' What the rail shows: m.channels the guide filter keeps (channelList
    ' indexes into this).
    m.railChannels = []
    ' Guide filter chip ("all", "sports", …), remembered on this device.
    m.filter = bowtie.guideFilter.parse(bowtie.registry.loadGuideFilter())
    ' True while the channel list (chips + rail or the filter's empty
    ' state) is shown: not loading, empty or failed.
    m.listShown = false
    ' Focus the chips when the list next shows (a timed refresh while on them).
    m.focusFiltersOnShow = false
    m.guideById = {}
    m.recents = []
    ' Continue watching items (normalized recordings, display order).
    m.continueItems = []
    ' In-flight Remove from Continue watching: {id, recordingId}.
    m.pendingRemove = invalid
    m.removeSeq = 0
    ' The recording a Continue item's * dialog acts on.
    m.optionsRecording = invalid
    ' Focus the Continue row when the list next shows (back from resuming).
    m.focusContinueOnShow = false
    ' Where focus goes when a dialog closes (invalid: the rail).
    m.returnFocus = invalid
    m.busy = false
    m.lastLoadedAt = 0
    ' * dialog: menu shown, and the channel + current program it acts on.
    m.dialog = invalid
    m.dialogMode = ""
    m.menu = []
    m.optionsChannelId = invalid
    m.optionsProgram = invalid
    ' In-flight createRecording / createRecordingRule: {id, channelId, program, series}.
    m.pendingRecord = invalid
    m.recSeq = 0
    ' Header button Up from the rail returns to (Recordings until one is left).
    m.headerButton = invalid

    m.settingsButton.observeField("buttonSelected", "onSettingsButton")
    m.recordingsButton.observeField("buttonSelected", "onRecordingsButton")
    m.retryButton.observeField("buttonSelected", "onRetryButton")
    m.channelList.observeField("itemSelected", "onItemSelected")
    m.recentList.observeField("itemSelected", "onRecentSelected")
    m.continueList.observeField("rowItemSelected", "onContinueSelected")
    m.filterList.observeField("itemSelected", "onFilterSelected")
    m.showAllButton.observeField("buttonSelected", "onShowAll")
    m.refreshTimer.observeField("fire", "onRefreshTimer")
    renderFilters()
    m.top.observeField("visible", "onVisible")
    m.top.observeField("apiTask", "onApiTaskSet")
end sub

sub onApiTaskSet()
    observeApi()
end sub

sub observeApi()
    unobserveApi()
    task = m.top.apiTask
    if task <> invalid
        task.observeFieldScoped("response", "onApiResponse")
        m.observing = true
    end if
end sub

sub unobserveApi()
    if m.observing = true
        task = m.top.apiTask
        if task <> invalid
            task.unobserveFieldScoped("response")
        end if
        m.observing = false
    end if
end sub

sub onVisible()
    if m.top.visible = true
        m.top.openSettings = false
        m.top.openRecordings = false
        m.top.selectedChannel = invalid
        m.top.resumeRecording = invalid
        updateUserLabel()
        observeApi()
        startRefreshTimer()
        ' Full refresh on every show (Task 4: refresh on show).
        loadChannels()
    else
        stopRefreshTimer()
        closeDialog()
        m.pendingRecord = invalid
        m.pendingRemove = invalid
        unobserveApi()
        setLoading(false)
    end if
end sub

sub updateUserLabel()
    uname = ""
    task = m.top.apiTask
    if task <> invalid and task.user <> invalid and task.user.username <> invalid
        uname = task.user.username
    end if
    m.userLabel.text = uname
end sub

sub startRefreshTimer()
    m.refreshTimer.control = "stop"
    m.refreshTimer.control = "start"
end sub

sub stopRefreshTimer()
    m.refreshTimer.control = "stop"
end sub

sub onRefreshTimer()
    if m.top.visible <> true then return
    if m.busy = true then return
    ' A reload moves focus; wait until the * dialog is gone.
    if m.dialog <> invalid then return
    ' Stale if never loaded or ≥ 5 minutes since last success.
    nowSecs = nowAsSeconds()
    if m.lastLoadedAt = 0 or (nowSecs - m.lastLoadedAt) >= 300
        loadChannels()
    end if
end sub

sub onSettingsButton()
    m.top.openSettings = true
end sub

sub onRecordingsButton()
    m.top.openRecordings = true
end sub

sub onRetryButton()
    loadChannels()
end sub

sub onItemSelected()
    idx = m.channelList.itemSelected
    if idx = invalid or idx < 0 or idx >= m.railChannels.count() then return
    ' The rail may be filtered; play the channel from the full rail.
    selectChannelAt(bowtie.favorites.indexOfChannel(m.channels, m.railChannels[idx].id))
end sub

sub onRecentSelected()
    idx = m.recentList.itemSelected
    if idx = invalid or idx < 0 or idx >= m.recents.count() then return
    ' Play from the rail so up/down zapping continues in rail order.
    selectChannelAt(bowtie.favorites.indexOfChannel(m.channels, m.recents[idx].channelId))
end sub

' OK on a filter chip: show that filter's channels and remember it.
sub onFilterSelected()
    idx = m.filterList.itemSelected
    list = bowtie.guideFilter.filters()
    if idx = invalid or idx < 0 or idx >= list.count() then return
    setFilter(list[idx])
end sub

' Show all (the filter matched nothing): back to All, focus on its chip.
sub onShowAll()
    setFilter("all")
    if m.filterList.visible = true then m.filterList.setFocus(true)
end sub

sub setFilter(filter as string)
    f = bowtie.guideFilter.parse(filter)
    if f = m.filter then return
    m.filter = f
    bowtie.registry.saveGuideFilter(f)
    renderFilters()
    renderRail(invalid)
end sub

' Rebuild the chips with the chosen one marked, focus kept on it.
sub renderFilters()
    root = CreateObject("roSGNode", "ContentNode")
    for each f in bowtie.guideFilter.filters()
        item = root.createChild("ContentNode")
        item.title = bowtie.guideFilter.label(f)
        item.addFields({ filterId: f, selected: (f = m.filter) })
    end for
    m.filterList.content = root
    m.filterList.jumpToItem = bowtie.guideFilter.indexOf(m.filter)
end sub

' OK on a Continue watching item: resume it (RecordingsScene plays it from
' its saved position and comes back here, focusing this row again).
sub onContinueSelected()
    sel = m.continueList.rowItemSelected
    if sel = invalid or sel.count() < 2 then return
    r = continueItemAt(sel[1])
    if r = invalid then return
    m.focusContinueOnShow = true
    m.top.resumeRecording = r
end sub

' The Continue item at a column, or invalid.
function continueItemAt(idx as dynamic) as dynamic
    if idx = invalid or idx < 0 or idx >= m.continueItems.count() then return invalid
    return m.continueItems[idx]
end function

' Column of the focused Continue item (-1 when none).
function focusedContinueIndex() as integer
    f = m.continueList.rowItemFocused
    if f = invalid or f.count() < 2 then return -1
    return f[1]
end function

sub selectChannelAt(idx as dynamic)
    if idx = invalid or idx < 0 then return
    if m.channels = invalid or idx >= m.channels.count() then return
    ch = m.channels[idx]
    if ch = invalid then return
    ' Player needs full rail for up/down zap + index for wrap.
    m.top.selectedChannel = {
        id: ch.id
        guideNumber: ch.guideNumber
        name: ch.name
        index: idx
        channels: m.channels
        ' The player's sleep timer offers End of this program from it.
        guide: m.guideById
    }
end sub

' Focus chain [Recordings | Settings] <-> continueList <-> recentList <->
' filterList <-> rail | Show all (hidden rows skipped), and * for the focused
' rail item's or Continue item's dialog. PlayerScene is a sibling, so its
' keys (where * belongs to the system menu) never reach here.
function onKeyEvent(key as string, press as boolean) as boolean
    if press <> true then return false

    if m.channelList.hasFocus()
        if key = "options"
            return openChannelOptions()
        end if
        ' MarkupList lets "up" through only from its first item; the chips
        ' are always right above a shown rail.
        if key = "up"
            if m.filterList.visible = true
                m.filterList.setFocus(true)
            else
                focusAboveFilters()
            end if
            return true
        end if
        return false
    end if

    ' Filter chips: the one-row MarkupGrid moves Left/Right itself (OK is
    ' itemSelected) and lets Up/Down through.
    if m.filterList.hasFocus()
        if key = "down"
            if m.channelList.visible = true
                m.channelList.setFocus(true)
                return true
            end if
            if m.filterEmptyGroup.visible = true
                m.showAllButton.setFocus(true)
                return true
            end if
            return false
        end if
        if key = "up"
            focusAboveFilters()
            return true
        end if
        return false
    end if

    if m.showAllButton.hasFocus()
        if key = "up"
            m.filterList.setFocus(true)
            return true
        end if
        return false
    end if

    if m.recentList.hasFocus()
        if key = "down"
            if m.filterList.visible = true
                m.filterList.setFocus(true)
                return true
            end if
            if m.channelList.visible = true
                m.channelList.setFocus(true)
                return true
            end if
            return false
        end if
        if key = "up"
            if m.continueList.visible = true
                m.continueList.setFocus(true)
            else
                focusHeader()
            end if
            return true
        end if
        return false
    end if

    ' Continue watching: a single-row RowList (floatingFocus) lets Up/Down
    ' through; Left/Right move along it.
    if m.continueList.hasFocus()
        if key = "options"
            return openContinueOptions()
        end if
        if key = "down"
            if m.recentList.visible = true
                m.recentList.setFocus(true)
                return true
            end if
            if m.filterList.visible = true
                m.filterList.setFocus(true)
                return true
            end if
            if m.channelList.visible = true
                m.channelList.setFocus(true)
                return true
            end if
            return false
        end if
        if key = "up"
            focusHeader()
            return true
        end if
        return false
    end if

    ' Header row: Recordings and Settings side by side.
    if m.recordingsButton.hasFocus() or m.settingsButton.hasFocus()
        if key = "right" and m.recordingsButton.hasFocus()
            m.settingsButton.setFocus(true)
            return true
        end if
        if key = "left" and m.settingsButton.hasFocus()
            m.recordingsButton.setFocus(true)
            return true
        end if
        if key = "down"
            m.headerButton = m.recordingsButton
            if m.settingsButton.hasFocus() then m.headerButton = m.settingsButton
            if m.continueList.visible = true
                m.continueList.setFocus(true)
                return true
            end if
            if m.recentList.visible = true
                m.recentList.setFocus(true)
                return true
            end if
            if m.filterList.visible = true
                m.filterList.setFocus(true)
                return true
            end if
            if m.channelList.visible = true
                m.channelList.setFocus(true)
                return true
            end if
        end if
    end if

    return false
end function

' Back up to the header button last left from (Recordings at first).
sub focusHeader()
    if m.headerButton = invalid then m.headerButton = m.recordingsButton
    m.headerButton.setFocus(true)
end sub

' Up from the chips: Recent, else Continue watching, else the header.
sub focusAboveFilters()
    if m.recentList.visible = true
        m.recentList.setFocus(true)
    else if m.continueList.visible = true
        m.continueList.setFocus(true)
    else
        focusHeader()
    end if
end sub

' ── * dialog ─────────────────────────────────────────────────────────────────

' Favorite/Unfavorite, Record this program (only with a current program in
' the guide already loaded), Cancel. The channel and program are captured
' now: the dialog takes focus and the rail may re-sort under it.
function openChannelOptions() as boolean
    idx = m.channelList.itemFocused
    if m.fav = invalid or idx = invalid or idx < 0 or idx >= m.railChannels.count() then return false
    ch = m.railChannels[idx]
    programs = m.guideById[ch.id.toStr()]
    if programs = invalid then programs = []
    nowProgram = bowtie.guide.nowNext(programs, isoNow()).now
    opts = bowtie.recordings.homeOptions(m.fav.supported, ch.favorite = true, nowProgram)
    ' Only Cancel (no favorites, nothing on now): nothing to offer.
    if opts.buttons.count() <= 1 then return false

    m.optionsChannelId = ch.id
    m.optionsProgram = nowProgram
    m.returnFocus = invalid
    m.menu = opts.buttons
    message = []
    if opts.note <> "" then message.push(opts.note)
    showDialog("channel", ch.guideNumber + "  " + ch.name, message, bowtie.recordings.buttonLabels(opts.buttons))
    return true
end function

' * on a Continue watching item: Remove from Continue watching, Cancel.
function openContinueOptions() as boolean
    r = continueItemAt(focusedContinueIndex())
    if r = invalid then return false
    m.optionsRecording = r
    m.returnFocus = m.continueList
    m.menu = bowtie.continueWatching.optionButtons()
    showDialog("continue", bowtie.recordings.titleLine(r), [bowtie.continueWatching.cardDetail(r)], bowtie.recordings.buttonLabels(m.menu))
    return true
end function

sub onDialogButton()
    if m.dialog = invalid then return
    idx = m.dialog.buttonSelected
    mode = m.dialogMode
    menu = m.menu
    closeDialog()
    restoreRailFocus()

    if mode = "continue"
        if bowtie.recordings.buttonId(menu, idx) = "remove" then sendRemoveContinue(m.optionsRecording)
    else if mode = "channel"
        choice = bowtie.recordings.buttonId(menu, idx)
        if choice = "favorite"
            toggleFavorite(m.optionsChannelId)
        else if choice = "record"
            sendRecord(m.optionsChannelId, m.optionsProgram, false)
        else if choice = "series"
            sendSeries(m.optionsChannelId, m.optionsProgram)
        end if
    else if mode = "conflict"
        ' Record anyway: lower priority; earlier recordings keep their tuners.
        if idx = 0 then sendRecord(m.optionsChannelId, m.optionsProgram, true)
    end if
end sub

' Optimistic: flip the star, re-sort in place (no reload: that would show the
' spinner and drop focus), keep focus on the same channel, then PUT/DELETE.
function toggleFavorite(channelId as dynamic) as boolean
    if m.fav = invalid or channelId = invalid then return false
    result = bowtie.favorites.toggle(m.fav, channelId)
    if result = invalid then return false
    m.channels = m.fav.channels
    renderRail(channelId)
    sendFavorite(channelId, result.on)
    return true
end function

' POST /recordings for the program by its exact guide start (the server
' matches it exactly). force = Record anyway after a 409.
sub sendRecord(channelId as dynamic, program as dynamic, force as boolean)
    task = m.top.apiTask
    if task = invalid or channelId = invalid or program = invalid or program.start = invalid then return
    m.recSeq = m.recSeq + 1
    reqId = "home-record-" + m.recSeq.toStr()
    m.pendingRecord = { id: reqId, channelId: channelId, program: program, series: false }
    task.request = {
        id: reqId
        kind: "createRecording"
        params: { channelId: channelId, programStart: program.start, force: force }
    }
end sub

' POST /recording-rules from the current program: this channel, new episodes
' only (the server's defaults). It schedules the upcoming airings at once.
sub sendSeries(channelId as dynamic, program as dynamic)
    task = m.top.apiTask
    if task = invalid or channelId = invalid or program = invalid or program.start = invalid then return
    m.recSeq = m.recSeq + 1
    reqId = "home-series-" + m.recSeq.toStr()
    m.pendingRecord = { id: reqId, channelId: channelId, program: program, series: true }
    task.request = {
        id: reqId
        kind: "createRecordingRule"
        params: { channelId: channelId, programStart: program.start }
    }
end sub

sub handleSeriesResponse(resp as object)
    m.pendingRecord = invalid
    if resp.ok = true
        ' "Scheduled N episodes." The next guide refresh brings their marks.
        showDialog("info", "Recording series", bowtie.recordings.seriesScheduledMessage(resp.data), ["OK"])
        return
    end if
    showDialog("info", "Can't record series", [bowtie.recordings.seriesErrorText(resp.error)], ["OK"])
end sub

sub handleRecordResponse(resp as object)
    pending = m.pendingRecord
    m.pendingRecord = invalid
    if resp.ok = true
        ' Mark the program (shared with m.guideById) so * no longer offers
        ' Record until the next guide refresh brings the server's mark.
        rec = invalid
        if resp.data <> invalid then rec = resp.data.recording
        if rec <> invalid and pending.program <> invalid
            pending.program.recording = { id: rec.id, state: rec.state }
        end if
        showDialog("info", "Recording scheduled", bowtie.recordings.scheduledMessage(resp.data), ["OK"])
        return
    end if

    err = resp.error
    code = 0
    if err <> invalid and err.code <> invalid then code = err.code
    if code = 409
        m.optionsChannelId = pending.channelId
        m.optionsProgram = pending.program
        showDialog("conflict", "Not enough tuners", bowtie.recordings.conflictMessage(err, localUtcOffset()), ["Record anyway", "Cancel"])
        return
    end if
    msg = "Couldn't schedule the recording."
    if code = 404
        msg = "That program isn't in the guide anymore."
    else if code = 503
        msg = "Recording isn't available on this server."
    else if err <> invalid and err.message <> invalid and err.message <> ""
        msg = err.message
    end if
    showDialog("info", "Can't record", [msg], ["OK"])
end sub

' Remove from Continue watching: reset this account's saved position to 0
' (the same PUT …/position playback uses); the item leaves the row once the
' server agrees.
sub sendRemoveContinue(r as dynamic)
    task = m.top.apiTask
    if task = invalid or r = invalid then return
    m.removeSeq = m.removeSeq + 1
    reqId = "home-continue-remove-" + m.removeSeq.toStr()
    m.pendingRemove = { id: reqId, recordingId: r.id }
    task.request = {
        id: reqId
        kind: "setRecordingPosition"
        params: { id: r.id, positionSec: 0 }
    }
end sub

sub handleRemoveResponse(resp as object)
    pending = m.pendingRemove
    m.pendingRemove = invalid
    if resp.ok <> true
        msg = "Couldn't remove it from Continue watching. Try again."
        if resp.error <> invalid and resp.error.message <> invalid and resp.error.message <> "" then msg = resp.error.message
        showDialog("info", "Can't remove", [msg], ["OK"])
        return
    end if
    idx = focusedContinueIndex()
    m.continueItems = bowtie.continueWatching.without(m.continueItems, pending.recordingId)
    renderContinue(idx)
    updateRows()
end sub

sub showDialog(mode as string, title as string, message as object, buttons as object)
    closeDialog()
    m.dialogMode = mode
    dialog = CreateObject("roSGNode", "StandardMessageDialog")
    dialog.title = title
    dialog.message = message
    dialog.buttons = buttons
    dialog.observeField("buttonSelected", "onDialogButton")
    dialog.observeField("wasClosed", "onDialogClosed")
    m.dialog = dialog
    scene = m.top.getScene()
    if scene <> invalid then scene.dialog = dialog
end sub

sub onDialogClosed()
    m.dialog = invalid
    m.dialogMode = ""
    if m.top.visible = true then restoreRailFocus()
end sub

sub closeDialog()
    if m.dialog <> invalid
        m.dialog.unobserveField("buttonSelected")
        m.dialog.unobserveField("wasClosed")
        m.dialog = invalid
    end if
    m.dialogMode = ""
    scene = m.top.getScene()
    if scene <> invalid and scene.dialog <> invalid
        scene.dialog.close = true
        scene.dialog = invalid
    end if
end sub

sub restoreRailFocus()
    ' Back to the Continue row when its dialog closes (if it's still shown).
    target = m.returnFocus
    if target <> invalid and target.visible = true
        target.setFocus(true)
    else if m.channelList.visible = true
        m.channelList.setFocus(true)
    else if m.filterEmptyGroup.visible = true
        m.showAllButton.setFocus(true)
    else
        focusHeader()
    end if
end sub

' Local = UTC + this. GetTimeZoneOffset is minutes from local to UTC (CDT → 300).
function localUtcOffset() as integer
    dt = CreateObject("roDateTime")
    return -dt.GetTimeZoneOffset() * 60
end function

sub sendFavorite(channelId as dynamic, on as boolean)
    task = m.top.apiTask
    if task = invalid then return
    m.favSeq = m.favSeq + 1
    reqId = "home-fav-" + m.favSeq.toStr()
    m.pendingFavs[reqId] = { channelId: channelId, on: on }
    task.request = {
        id: reqId
        kind: "setFavorite"
        params: { channelId: channelId, on: on }
    }
end sub

sub handleFavoriteResponse(resp as object)
    pending = m.pendingFavs[resp.id]
    m.pendingFavs.Delete(resp.id)
    if m.fav = invalid then return
    ' Remember the focused channel; a revert can move it.
    focusedId = invalid
    idx = m.channelList.itemFocused
    if idx <> invalid and idx >= 0 and idx < m.railChannels.count() then focusedId = m.railChannels[idx].id
    if bowtie.favorites.resolve(m.fav, pending.channelId, pending.on, resp.ok = true)
        m.channels = m.fav.channels
        renderRail(focusedId)
    end if
end sub

sub loadChannels()
    task = m.top.apiTask
    if task = invalid then return

    m.loadGen = m.loadGen + 1
    gen = m.loadGen
    m.busy = true
    m.pendingChannelsId = "home-channels-" + gen.toStr()
    m.pendingGuideId = ""
    m.pendingRecentsId = ""
    m.pendingContinueId = ""
    ' The reload is queued behind any PUT/DELETE, so it returns server truth.
    m.pendingFavs = {}
    ' A timed refresh while on the Continue row (or the chips) lands back on it.
    if m.continueList.hasFocus() then m.focusContinueOnShow = true
    if m.filterList.hasFocus() then m.focusFiltersOnShow = true
    showLoading()

    task.request = {
        id: m.pendingChannelsId
        kind: "channels"
        params: {}
    }
end sub

sub loadGuide()
    task = m.top.apiTask
    if task = invalid then return

    gen = m.loadGen
    m.pendingGuideId = "home-guide-" + gen.toStr()
    window = guideWindow()
    task.request = {
        id: m.pendingGuideId
        kind: "guide"
        params: {
            start: window.start
            stop: window.stop
        }
    }
end sub

sub loadRecents()
    task = m.top.apiTask
    if task = invalid then return
    m.pendingRecentsId = "home-recents-" + m.loadGen.toStr()
    task.request = {
        id: m.pendingRecentsId
        kind: "recents"
        params: { limit: RECENTS_LIMIT }
    }
end sub

' Continue watching: this account's recorded list (ready + converting) with
' positions; bowtie.continueWatching keeps the part-watched ones.
sub loadContinue()
    task = m.top.apiTask
    if task = invalid then return
    m.pendingContinueId = "home-continue-" + m.loadGen.toStr()
    task.request = {
        id: m.pendingContinueId
        kind: "recordings"
        params: { state: "recorded" }
    }
end sub

sub onApiResponse()
    task = m.top.apiTask
    if task = invalid then return
    if m.top.visible <> true then return
    resp = task.response
    if resp = invalid then return

    if resp.id = m.pendingChannelsId
        handleChannelsResponse(resp)
        return
    end if
    if resp.id = m.pendingGuideId and m.pendingGuideId <> ""
        handleGuideResponse(resp)
        return
    end if
    if resp.id = m.pendingRecentsId and m.pendingRecentsId <> ""
        handleRecentsResponse(resp)
        return
    end if
    if resp.id = m.pendingContinueId and m.pendingContinueId <> ""
        handleContinueResponse(resp)
        return
    end if
    if m.pendingRemove <> invalid and resp.id = m.pendingRemove.id
        handleRemoveResponse(resp)
        return
    end if
    if resp.id <> invalid and m.pendingFavs.DoesExist(resp.id)
        handleFavoriteResponse(resp)
        return
    end if
    if m.pendingRecord <> invalid and resp.id = m.pendingRecord.id
        if m.pendingRecord.series = true
            handleSeriesResponse(resp)
        else
            handleRecordResponse(resp)
        end if
        return
    end if
end sub

sub handleChannelsResponse(resp as object)
    m.pendingChannelsId = ""
    if resp.ok <> true
        m.busy = false
        showError(errorMessage(resp))
        return
    end if

    ' API may return a bare array or {channels: [...]}; favorites first.
    m.fav = bowtie.favorites.newState(resp.data)
    m.channels = m.fav.channels
    m.railChannels = []
    m.recents = []
    m.continueItems = []
    renderContinue(-1)

    if m.channels.count() = 0
        m.busy = false
        m.lastLoadedAt = nowAsSeconds()
        showEmpty()
        return
    end if

    ' Recents first (ApiTask is FIFO), so the row is ready when the guide
    ' response shows the rail and both paint together. An older server
    ' without favorites has no /me/recents either.
    if m.fav.supported then loadRecents()
    ' Continue watching likewise lands before the guide.
    loadContinue()
    ' Fetch guide for now/next join.
    loadGuide()
end sub

sub handleGuideResponse(resp as object)
    m.pendingGuideId = ""
    m.busy = false
    m.lastLoadedAt = nowAsSeconds()

    m.guideById = {}
    if resp.ok = true and resp.data <> invalid
        m.guideById = indexGuide(resp.data)
    end if

    renderRail(invalid)
    showList()
end sub

sub handleRecentsResponse(resp as object)
    m.pendingRecentsId = ""
    ' Any error (404 from a server without recents included) hides the row.
    recents = []
    if resp.ok = true
        for each r in bowtie.favorites.parseRecents(resp.data)
            ' Only channels on the rail: selecting one plays from the rail.
            if bowtie.favorites.indexOfChannel(m.channels, r.channelId) >= 0 then recents.push(r)
        end for
    end if
    m.recents = recents
    renderRecents()
    updateRows()
end sub

sub handleContinueResponse(resp as object)
    m.pendingContinueId = ""
    ' Any error (404 from a server without recordings included) hides the row.
    items = []
    if resp.ok = true then items = bowtie.continueWatching.fromResponse(resp.data)
    m.continueItems = items
    renderContinue(-1)
    updateRows()
end sub

' Rebuild the Continue row's cards from m.continueItems; keep focus near
' column focusIdx when given (after a remove).
sub renderContinue(focusIdx as integer)
    root = CreateObject("roSGNode", "ContentNode")
    n = m.continueItems.count()
    ' No empty row: the RowList just has no content while the row is hidden.
    if n > 0
        row = root.createChild("ContentNode")
        for each r in m.continueItems
            item = row.createChild("ContentNode")
            item.title = bowtie.recordings.titleLine(r)
            item.addFields({
                detail: bowtie.continueWatching.cardDetail(r)
                progress: bowtie.continueWatching.progress(r)
                recordingId: r.id
            })
        end for
    end if
    m.continueList.content = root
    if focusIdx >= 0 and n > 0
        if focusIdx >= n then focusIdx = n - 1
        m.continueList.jumpToRowItem = [0, focusIdx]
    end if
end sub

' Rebuild the rail from m.channels, the guide filter and the last guide;
' keep focus on focusChannelId when given (its index changes when favorites
' re-sort).
sub renderRail(focusChannelId as dynamic)
    atIso = isoNow()
    m.railChannels = bowtie.guideFilter.channelsMatching(m.channels, m.guideById, m.filter, atIso)
    m.channelList.content = buildListContent(m.railChannels, m.guideById, atIso)
    if focusChannelId <> invalid
        idx = bowtie.favorites.indexOfChannel(m.railChannels, focusChannelId)
        if idx >= 0 then m.channelList.jumpToItem = idx
    end if
    updateRows()
end sub

' While the list is shown: the chips always, the rail when the filter keeps
' a channel (else the filter's empty copy + Show all), and the Continue and
' Recent rows each when it has items; the rows below shift down and the rail
' loses rows to make room (bowtie.continueWatching.homeLayout). Focus on a
' row being hidden moves down to the next shown row.
sub updateRows()
    listShown = (m.listShown = true)
    showContinue = (listShown and m.continueItems.count() > 0)
    showRecent = (listShown and m.recents.count() > 0)
    showRail = (listShown and m.railChannels.count() > 0)
    showFilterEmpty = (listShown and not showRail)
    if showFilterEmpty then m.filterEmptyLabel.text = bowtie.guideFilter.emptyCopy(m.filter)

    layout = bowtie.continueWatching.homeLayout(showContinue, showRecent)
    m.continueLabel.translation = [80, layout.continueLabelY]
    m.continueList.translation = [80, layout.continueY]
    m.recentLabel.translation = [80, layout.recentLabelY]
    m.recentList.translation = [80, layout.recentY]
    m.filterList.translation = [80, layout.filtersY]
    m.channelList.translation = [80, layout.railY]
    m.channelList.numRows = layout.railRows
    m.filterEmptyGroup.translation = [0, layout.railY]
    m.continueLabel.visible = showContinue
    m.continueList.visible = showContinue
    m.recentLabel.visible = showRecent
    m.recentList.visible = showRecent
    m.filterList.visible = listShown
    m.channelList.visible = showRail
    m.filterEmptyGroup.visible = showFilterEmpty

    ' Focus on something that went moves down: Continue → Recent → the rail
    ' (or Show all), else the chips, else the header.
    if not showContinue and m.continueList.hasFocus()
        if showRecent
            m.recentList.setFocus(true)
        else
            focusRailArea()
        end if
    end if
    if not showRecent and m.recentList.hasFocus() then focusRailArea()
    if not showRail and m.channelList.hasFocus() then focusRailArea()
    if not showFilterEmpty and m.showAllButton.hasFocus() then focusRailArea()
    if not listShown and m.filterList.hasFocus() then focusHeader()
end sub

' The rail if shown, else Show all if shown, else the chips, else the header.
sub focusRailArea()
    if m.channelList.visible = true
        m.channelList.setFocus(true)
    else if m.filterEmptyGroup.visible = true
        m.showAllButton.setFocus(true)
    else if m.filterList.visible = true
        m.filterList.setFocus(true)
    else
        focusHeader()
    end if
end sub

' The Recent row's cards from m.recents.
sub renderRecents()
    root = CreateObject("roSGNode", "ContentNode")
    for each r in m.recents
        item = root.createChild("ContentNode")
        item.title = r.name
        item.addFields({ guideNumber: r.guideNumber, channelId: r.channelId })
    end for
    m.recentList.content = root
end sub

function indexGuide(data as object) as object
    byId = {}
    list = data
    if type(data) <> "roArray"
        if data.channels <> invalid
            list = data.channels
        else
            return byId
        end if
    end if
    for each gc in list
        if gc <> invalid and gc.channelId <> invalid
            key = gc.channelId.toStr()
            programs = gc.programs
            if programs = invalid then programs = []
            byId[key] = programs
        end if
    end for
    return byId
end function

function buildListContent(channels as object, guideById as object, atIso as string) as object
    root = CreateObject("roSGNode", "ContentNode")
    for each ch in channels
        key = ch.id.toStr()
        programs = guideById[key]
        if programs = invalid then programs = []
        nn = bowtie.guide.nowNext(programs, atIso)
        nowTitle = ""
        nextTitle = ""
        progress = 0.0
        if nn.now <> invalid
            if nn.now.title <> invalid then nowTitle = nn.now.title
            progress = programProgress(nn.now, atIso)
        end if
        if nn.next <> invalid and nn.next.title <> invalid
            nextTitle = nn.next.title
        end if

        item = root.createChild("ContentNode")
        item.title = ch.name
        item.addFields({
            guideNumber: ch.guideNumber
            channelId: ch.id
            nowTitle: nowTitle
            nextTitle: nextTitle
            progress: progress
            favorite: ch.favorite
            rowKind: "channel"
        })
    end for
    return root
end function

function programProgress(program as object, atIso as string) as float
    if program = invalid then return 0.0
    if program.start = invalid or program.stop = invalid then return 0.0
    startSecs = isoToSeconds(program.start)
    stopSecs = isoToSeconds(program.stop)
    atSecs = isoToSeconds(atIso)
    total = stopSecs - startSecs
    if total <= 0 then return 0.0
    elapsed = atSecs - startSecs
    p = elapsed / total
    if p < 0 then p = 0
    if p > 1 then p = 1
    return p
end function

function guideWindow() as object
    dt = CreateObject("roDateTime")
    dt.Mark() ' roDateTime stays UTC unless ToLocalTime() is called
    startIso = dt.ToISOString()
    secs = dt.AsSeconds() + GUIDE_WINDOW_SECS
    dt.FromSeconds(secs)
    stopIso = dt.ToISOString()
    return { start: startIso, stop: stopIso }
end function

function isoNow() as string
    dt = CreateObject("roDateTime")
    dt.Mark()
    return dt.ToISOString()
end function

function isoToSeconds(iso as string) as integer
    if iso = invalid or iso = "" then return 0
    dt = CreateObject("roDateTime")
    dt.FromISO8601String(iso)
    return dt.AsSeconds()
end function

function nowAsSeconds() as integer
    dt = CreateObject("roDateTime")
    dt.Mark()
    return dt.AsSeconds()
end function

function errorMessage(resp as object) as string
    if resp = invalid then return "Couldn't load channels."
    if resp.error <> invalid
        msg = resp.error.message
        if msg <> invalid and msg <> "" then return msg
    end if
    return "Couldn't load channels."
end function

sub showLoading()
    m.loadingGroup.visible = true
    if m.loadingSpinner <> invalid
        m.loadingSpinner.control = "start"
    end if
    m.emptyLabel.visible = false
    m.errorGroup.visible = false
    m.listShown = false
    m.settingsButton.setFocus(true)
    updateRows()
end sub

sub showEmpty()
    setLoading(false)
    m.emptyLabel.text = EMPTY_COPY
    m.emptyLabel.visible = true
    m.errorGroup.visible = false
    m.listShown = false
    m.settingsButton.setFocus(true)
    m.focusContinueOnShow = false
    m.focusFiltersOnShow = false
    updateRows()
end sub

sub showError(message as string)
    setLoading(false)
    m.emptyLabel.visible = false
    m.errorGroup.visible = true
    m.errorLabel.text = message
    m.listShown = false
    m.retryButton.setFocus(true)
    m.focusContinueOnShow = false
    m.focusFiltersOnShow = false
    updateRows()
end sub

sub showList()
    setLoading(false)
    m.emptyLabel.visible = false
    m.errorGroup.visible = false
    m.listShown = true
    updateRows()
    ' Back from resuming a Continue item: land on that row (its first card
    ' is the one just watched) if it's still there; a timed refresh while on
    ' the chips stays there; else the rail (Show all when the filter left it
    ' empty).
    if m.focusContinueOnShow = true and m.continueList.visible = true
        m.continueList.jumpToRowItem = [0, 0]
        m.continueList.setFocus(true)
    else if m.focusFiltersOnShow = true
        m.filterList.setFocus(true)
    else if m.channelList.visible = true
        m.channelList.setFocus(true)
    else
        m.showAllButton.setFocus(true)
    end if
    m.focusContinueOnShow = false
    m.focusFiltersOnShow = false
end sub

sub setLoading(on as boolean)
    m.loadingGroup.visible = on
    if m.loadingSpinner <> invalid
        if on
            m.loadingSpinner.control = "start"
        else
            m.loadingSpinner.control = "stop"
        end if
    end if
end sub
