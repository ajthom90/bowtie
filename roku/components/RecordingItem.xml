<?xml version="1.0" encoding="utf-8" ?>
<component name="RecordingItem" extends="Group">
    <!-- RecordingsScene row: title line over a when · channel · size · status line. -->
    <interface>
        <field id="width" type="float" onChange="onSizeChanged" />
        <field id="height" type="float" onChange="onSizeChanged" />
        <field id="itemContent" type="node" onChange="onItemContent" />
        <field id="focusPercent" type="float" onChange="onFocusChanged" />
        <field id="listHasFocus" type="boolean" onChange="onFocusChanged" />
        <field id="itemHasFocus" type="boolean" onChange="onFocusChanged" />
    </interface>
    <script type="text/brightscript" uri="RecordingItem.bs" />
    <children>
        <Rectangle
            id="rowBg"
            width="1760"
            height="112"
            color="0x1A2028FF"
        />
        <Label
            id="titleLabel"
            translation="[32, 14]"
            width="1696"
            height="44"
            text=""
            horizAlign="left"
            vertAlign="center"
            color="0xF2EFE8FF"
            font="font:MediumBoldSystemFont"
        />
        <Label
            id="detailLabel"
            translation="[32, 62]"
            width="1696"
            height="36"
            text=""
            horizAlign="left"
            vertAlign="center"
            color="0x9BA5AEFF"
            font="font:SmallSystemFont"
        />
    </children>
</component>
