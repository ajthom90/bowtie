<?xml version="1.0" encoding="utf-8" ?>
<component name="AppScene" extends="Scene">
    <script type="text/brightscript" uri="AppScene.bs" />
    <children>
        <Rectangle
            id="background"
            width="1920"
            height="1080"
            color="0x101418FF"
        />

        <!-- Quiet splash while boot-refresh is in flight (A2 Checking). -->
        <Group id="checkingGroup" visible="false">
            <Label
                id="checkingTitle"
                width="1920"
                height="80"
                translation="[0, 440]"
                text="Bowtie"
                horizAlign="center"
                color="0xF0A428FF"
                font="font:LargeBoldSystemFont"
            />
            <Label
                id="checkingHint"
                width="1920"
                height="40"
                translation="[0, 540]"
                text="Signing in…"
                horizAlign="center"
                color="0x9BA5AEFF"
                font="font:MediumSystemFont"
            />
            <BusySpinner
                id="checkingSpinner"
                translation="[920, 620]"
                visible="true"
                control="start"
            />
        </Group>

        <ConnectScene id="connectScene" visible="false" />
        <LoginScene id="loginScene" visible="false" />
        <HomeScene id="homeScene" visible="false" />
        <SettingsScene id="settingsScene" visible="false" />
        <PlayerScene id="playerScene" visible="false" />
    </children>
</component>
