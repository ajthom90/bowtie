<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeScene" extends="Group">
    <interface>
        <field id="apiTask" type="node" />
        <!-- True when user opens Settings. -->
        <field id="openSettings" type="boolean" alwaysNotify="true" value="false" />
        <!-- True when user opens Recordings. -->
        <field id="openRecordings" type="boolean" alwaysNotify="true" value="false" />
        <!-- Channel AA selected for play: {id, guideNumber, name, index, channels}. -->
        <field id="selectedChannel" type="assocarray" alwaysNotify="true" />
        <!-- Continue watching item to resume (a normalized recording); AppScene
             hands it to RecordingsScene, which plays it from its saved position. -->
        <field id="resumeRecording" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="HomeScene.bs" />
    <children>
        <Rectangle
            id="background"
            width="1920"
            height="1080"
            color="0x101418FF"
        />

        <!-- Header -->
        <Label
            id="titleLabel"
            translation="[80, 40]"
            width="800"
            height="56"
            text="Channels"
            horizAlign="left"
            vertAlign="center"
            color="0xF2EFE8FF"
            font="font:LargeBoldSystemFont"
        />
        <Label
            id="userLabel"
            translation="[80, 96]"
            width="800"
            height="32"
            text=""
            horizAlign="left"
            vertAlign="center"
            color="0x9BA5AEFF"
            font="font:SmallSystemFont"
        />
        <Button
            id="recordingsButton"
            translation="[1260, 48]"
            text="Recordings"
            minWidth="240"
            maxWidth="296"
            height="56"
        />
        <Button
            id="settingsButton"
            translation="[1560, 48]"
            text="Settings"
            minWidth="240"
            height="56"
        />

        <!-- Loading -->
        <Group id="loadingGroup" visible="false">
            <BusySpinner
                id="loadingSpinner"
                translation="[920, 480]"
                visible="true"
                control="stop"
            />
            <Label
                id="loadingLabel"
                translation="[0, 560]"
                width="1920"
                height="40"
                text="Loading channels…"
                horizAlign="center"
                color="0x9BA5AEFF"
                font="font:MediumSystemFont"
            />
        </Group>

        <!-- Empty -->
        <Label
            id="emptyLabel"
            translation="[200, 460]"
            width="1520"
            height="80"
            text="No channels yet. Ask your admin to enable some."
            horizAlign="center"
            vertAlign="center"
            color="0x9BA5AEFF"
            font="font:MediumSystemFont"
            wrap="true"
            visible="false"
        />

        <!-- Error -->
        <Group id="errorGroup" visible="false">
            <Label
                id="errorLabel"
                translation="[200, 420]"
                width="1520"
                height="80"
                text=""
                horizAlign="center"
                color="0xE05050FF"
                font="font:MediumSystemFont"
                wrap="true"
            />
            <Button
                id="retryButton"
                translation="[760, 540]"
                text="Try again"
                minWidth="400"
                height="56"
            />
        </Group>

        <!-- Continue watching (part-watched recordings, GET /recordings?state=recorded
             filtered by bowtie.continueWatching). Shown only when non-empty, above
             Recent; HomeScene places the rows with bowtie.continueWatching.homeLayout.
             A one-row RowList so up to 10 cards scroll sideways; floatingFocus
             (not the default fixedFocusWrap) so Up/Down reach HomeScene. -->
        <Label
            id="continueLabel"
            translation="[80, 136]"
            width="800"
            height="32"
            text="Continue watching"
            horizAlign="left"
            vertAlign="center"
            color="0x9BA5AEFF"
            font="font:SmallSystemFont"
            visible="false"
        />
        <RowList
            id="continueList"
            translation="[80, 172]"
            itemComponentName="ContinueItem"
            itemSize="[1760, 112]"
            rowItemSize="[[344, 112]]"
            rowItemSpacing="[[10, 0]]"
            itemSpacing="[0, 0]"
            numRows="1"
            showRowLabel="[false]"
            showRowCounter="[false]"
            rowFocusAnimationStyle="floatingFocus"
            vertFocusAnimationStyle="floatingFocus"
            drawFocusFeedback="true"
            drawFocusFeedbackOnTop="true"
            focusBitmapUri="pkg:/images/focus_amber.9.png"
            visible="false"
        />

        <!-- Recent row (GET /me/recents). Shown only when non-empty; while it is,
             HomeScene moves the chips to y=280 and the rail to y=352 with 5 rows
             (both rows: Recent at y=336, chips at y=444, rail at y=516 with 4).
             Horizontal, so a one-row MarkupGrid (MarkupList is vertical-only). -->
        <Label
            id="recentLabel"
            translation="[80, 136]"
            width="800"
            height="32"
            text="Recent"
            horizAlign="left"
            vertAlign="center"
            color="0x9BA5AEFF"
            font="font:SmallSystemFont"
            visible="false"
        />
        <MarkupGrid
            id="recentList"
            translation="[80, 172]"
            itemComponentName="RecentChannelItem"
            itemSize="[208, 88]"
            itemSpacing="[12, 0]"
            numColumns="8"
            numRows="1"
            drawFocusFeedback="true"
            drawFocusFeedbackOnTop="true"
            focusBitmapUri="pkg:/images/focus_amber.9.png"
            visible="false"
        />

        <!-- Guide filter chips (All · Sports · Movies · News · Kids · New,
             bowtie.guideFilter), directly above the rail and shown with it.
             A one-row MarkupGrid: Left/Right move, OK picks; Up/Down reach
             HomeScene. The chosen chip is remembered in the registry. -->
        <MarkupGrid
            id="filterList"
            translation="[80, 136]"
            itemComponentName="FilterChip"
            itemSize="[160, 56]"
            itemSpacing="[16, 0]"
            numColumns="6"
            numRows="1"
            drawFocusFeedback="true"
            drawFocusFeedbackOnTop="true"
            focusBitmapUri="pkg:/images/focus_amber.9.png"
            visible="false"
        />

        <!-- A filter with no matching channels: the rail is hidden and this
             shows in its place, with Show all (focusable) back to All. -->
        <Group id="filterEmptyGroup" translation="[0, 208]" visible="false">
            <Label
                id="filterEmptyLabel"
                translation="[200, 120]"
                width="1520"
                height="60"
                text=""
                horizAlign="center"
                vertAlign="center"
                color="0x9BA5AEFF"
                font="font:MediumSystemFont"
            />
            <Button
                id="showAllButton"
                translation="[760, 220]"
                text="Show all"
                minWidth="400"
                height="56"
            />
        </Group>

        <!-- Channel rail (only the channels the filter keeps) -->
        <MarkupList
            id="channelList"
            translation="[80, 208]"
            itemComponentName="ChannelRailItem"
            itemSize="[1760, 120]"
            itemSpacing="[0, 8]"
            numRows="6"
            drawFocusFeedback="true"
            drawFocusFeedbackOnTop="true"
            focusBitmapUri="pkg:/images/focus_amber.9.png"
            visible="false"
        />

        <!-- 5-minute guide/channel refresh while home is visible -->
        <Timer
            id="refreshTimer"
            duration="300"
            repeat="true"
        />
    </children>
</component>
