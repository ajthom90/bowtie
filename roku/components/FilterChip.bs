' MarkupGrid item for HomeScene's guide filter chips: the label, filled amber
' with dark text when it is the chosen filter; a focused, unchosen chip's
' text turns amber (the ring comes from the grid's focusBitmapUri).

sub init()
    m.chipBg = m.top.findNode("chipBg")
    m.chipLabel = m.top.findNode("chipLabel")
    m.selected = false
end sub

sub onItemContent()
    content = m.top.itemContent
    if content = invalid then return
    text = content.title
    if text = invalid then text = ""
    m.chipLabel.text = text
    m.selected = (content.selected = true)
    applyColors()
end sub

sub onSizeChanged()
    w = m.top.width
    h = m.top.height
    if w = invalid or w <= 0 then w = 160
    if h = invalid or h <= 0 then h = 56
    m.chipBg.width = w
    m.chipBg.height = h
    m.chipLabel.width = w
    m.chipLabel.height = h
end sub

sub onFocusChanged()
    applyColors()
end sub

sub applyColors()
    focused = false
    if m.top.gridHasFocus = true and m.top.focusPercent <> invalid and m.top.focusPercent > 0.5
        focused = true
    end if
    if m.top.itemHasFocus = true then focused = true
    if m.selected
        m.chipBg.color = "0xF0A428FF"
        m.chipLabel.color = "0x101418FF"
    else if focused
        m.chipBg.color = "0x1A2028FF"
        m.chipLabel.color = "0xF0A428FF"
    else
        m.chipBg.color = "0x1A2028FF"
        m.chipLabel.color = "0xF2EFE8FF"
    end if
end sub
