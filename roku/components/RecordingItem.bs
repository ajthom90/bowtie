' MarkupList item for RecordingsScene: title + detail line. Missed rows
' (failed) tint the detail red so the reason stands out.

sub init()
    m.rowBg = m.top.findNode("rowBg")
    m.titleLabel = m.top.findNode("titleLabel")
    m.detailLabel = m.top.findNode("detailLabel")
end sub

sub onItemContent()
    content = m.top.itemContent
    if content = invalid then return
    title = content.title
    if title = invalid then title = ""
    detail = content.detail
    if detail = invalid then detail = ""
    m.titleLabel.text = title
    m.detailLabel.text = detail
    if content.missed = true
        m.detailLabel.color = "0xE05050FF"
    else
        m.detailLabel.color = "0x9BA5AEFF"
    end if
end sub

sub onSizeChanged()
    w = m.top.width
    h = m.top.height
    if w = invalid or w <= 0 then w = 1760
    if h = invalid or h <= 0 then h = 112
    m.rowBg.width = w
    m.rowBg.height = h
    m.titleLabel.width = w - 64
    m.detailLabel.width = w - 64
end sub

sub onFocusChanged()
    ' Focus ring comes from MarkupList focusBitmapUri; tint the title like the rail.
    focused = false
    if m.top.listHasFocus = true and m.top.focusPercent <> invalid and m.top.focusPercent > 0.5
        focused = true
    end if
    if m.top.itemHasFocus = true then focused = true
    if focused
        m.titleLabel.color = "0xF0A428FF"
    else
        m.titleLabel.color = "0xF2EFE8FF"
    end if
end sub
