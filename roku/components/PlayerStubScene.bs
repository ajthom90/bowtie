' Task 4 stub player: channel identity + Back. Task 5 replaces with real PlayerScene.

sub init()
    m.numberLabel = m.top.findNode("numberLabel")
    m.nameLabel = m.top.findNode("nameLabel")
    m.backButton = m.top.findNode("backButton")

    m.backButton.observeField("buttonSelected", "onBackButton")
    m.top.observeField("visible", "onVisible")
    m.top.observeField("channelName", "onChannelFields")
    m.top.observeField("guideNumber", "onChannelFields")
end sub

sub onVisible()
    if m.top.visible = true
        m.top.closed = false
        onChannelFields()
        m.backButton.setFocus(true)
    end if
end sub

sub onChannelFields()
    gn = m.top.guideNumber
    if gn = invalid then gn = ""
    name = m.top.channelName
    if name = invalid then name = ""
    m.numberLabel.text = gn
    m.nameLabel.text = name
end sub

sub onBackButton()
    m.top.closed = true
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if press = true and key = "back"
        m.top.closed = true
        return true
    end if
    return false
end function
