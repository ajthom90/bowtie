' Pure request builders / response parsers for the Bowtie viewer API.
' Transport (roUrlTransfer) lives in ApiTask — this module has no I/O.
'
' buildRequest kinds: healthz, login, refresh, logout, me, changePassword,
'   channels, guide, createSession, deleteSession, heartbeat, setFavorite, recents,
'   recordings, createRecording, deleteRecording, stopRecording, playRecording,
'   setRecordingPosition, protectRecording, recordingRules, createRecordingRule,
'   deleteRecordingRule, deviceStart, deviceToken
' parseResponse: ok/data or ok/error; createSession resolves absolute playlistUrl (A4);
'   login/refresh surface user with maxQuality (A1).
' heartbeat: stream-token query only (no Bearer); 204 success.
' setFavorite: params {channelId, on} → PUT (on) / DELETE (off); 204 success.
' recents: GET /me/recents?limit=n; 404 (older server) → notFound.
' DVR (tag dvr): recordings {state?}; createRecording {channelId, programStart,
'   force?} → 201 {recording, warnings} or 409 kind "conflict" {tunerCount,
'   conflicts}; deleteRecording / stopRecording {id} → 204; playRecording {id}
'   → {playlistUrl (absolute), positionSec, durationSec}; setRecordingPosition
'   {id, positionSec} → 204; protectRecording {id, keep} → PATCH {protected}.
' Series (tag dvr): recordingRules → GET list; createRecordingRule {channelId,
'   programStart} → 201 {rule, scheduled}; deleteRecordingRule {id} → 204.
' Quick sign-in (no Bearer): deviceStart {deviceName} → {deviceCode, userCode,
'   verifyUrl, qrUrl (absolute), expiresIn, interval}; deviceToken {deviceCode}
'   → 200 TokenPair (as login), 428 kind "pending", 410 kind "expired".

namespace bowtie.client

    function buildRequest(kind as string, params as object, accessToken as string, baseUrl as string) as object
        if params = invalid then params = {}
        base = bowtie.client.normalizeBase(baseUrl)
        headers = { "Content-Type": "application/json" }
        method = "GET"
        url = base
        body = ""
        timeoutMs = 10000

        if kind = "healthz"
            url = base + "/healthz"
            method = "GET"
            headers = {}
            timeoutMs = 2000

        else if kind = "login"
            url = base + "/api/v1/auth/login"
            method = "POST"
            body = FormatJson({
                "username": params.username
                "password": params.password
            })

        else if kind = "deviceStart"
            url = base + "/api/v1/auth/device"
            method = "POST"
            name = params.deviceName
            if name = invalid then name = ""
            body = FormatJson({ "deviceName": name })

        else if kind = "deviceToken"
            url = base + "/api/v1/auth/device/token"
            method = "POST"
            code = params.deviceCode
            if code = invalid then code = ""
            body = FormatJson({ "deviceCode": code })

        else if kind = "refresh"
            url = base + "/api/v1/auth/refresh"
            method = "POST"
            body = FormatJson({
                "refreshToken": params.refreshToken
            })

        else if kind = "logout"
            url = base + "/api/v1/auth/logout"
            method = "POST"
            rt = params.refreshToken
            if rt = invalid then rt = ""
            body = FormatJson({ "refreshToken": rt })

        else if kind = "me"
            url = base + "/api/v1/me"
            method = "GET"
            headers = bowtie.client.authHeaders(accessToken)

        else if kind = "changePassword"
            url = base + "/api/v1/me/password"
            method = "POST"
            headers = bowtie.client.authHeaders(accessToken)
            headers["Content-Type"] = "application/json"
            body = FormatJson({
                "currentPassword": params.currentPassword
                "newPassword": params.newPassword
            })

        else if kind = "channels"
            url = base + "/api/v1/channels"
            method = "GET"
            headers = bowtie.client.authHeaders(accessToken)

        else if kind = "guide"
            startIso = params.start
            stopIso = params.stop
            url = base + "/api/v1/guide?start=" + startIso + "&stop=" + stopIso
            method = "GET"
            headers = bowtie.client.authHeaders(accessToken)

        else if kind = "setFavorite"
            url = base + "/api/v1/me/favorites/" + bowtie.client.idString(params.channelId)
            method = "DELETE"
            if params.on = true then method = "PUT"
            headers = bowtie.client.authHeaders(accessToken)

        else if kind = "recents"
            limit = params.limit
            if limit = invalid then limit = 8
            url = base + "/api/v1/me/recents?limit=" + bowtie.client.idString(limit)
            method = "GET"
            headers = bowtie.client.authHeaders(accessToken)

        else if kind = "recordings"
            url = base + "/api/v1/recordings"
            if params.state <> invalid and params.state <> "" then url = url + "?state=" + params.state
            method = "GET"
            headers = bowtie.client.authHeaders(accessToken)

        else if kind = "createRecording"
            url = base + "/api/v1/recordings"
            method = "POST"
            headers = bowtie.client.jsonAuthHeaders(accessToken)
            payload = {
                "channelId": params.channelId
                "programStart": params.programStart
            }
            if params.force = true then payload["force"] = true
            body = FormatJson(payload)

        else if kind = "deleteRecording"
            url = bowtie.client.recordingUrl(base, params.id, "")
            method = "DELETE"
            headers = bowtie.client.authHeaders(accessToken)

        else if kind = "stopRecording"
            url = bowtie.client.recordingUrl(base, params.id, "/stop")
            method = "POST"
            headers = bowtie.client.authHeaders(accessToken)

        else if kind = "playRecording"
            url = bowtie.client.recordingUrl(base, params.id, "/play")
            method = "POST"
            headers = bowtie.client.authHeaders(accessToken)

        else if kind = "setRecordingPosition"
            url = bowtie.client.recordingUrl(base, params.id, "/position")
            method = "PUT"
            headers = bowtie.client.jsonAuthHeaders(accessToken)
            positionSec = 0
            if params.positionSec <> invalid and params.positionSec > 0 then positionSec = Int(params.positionSec)
            body = FormatJson({ "positionSec": positionSec })

        else if kind = "protectRecording"
            url = bowtie.client.recordingUrl(base, params.id, "")
            method = "PATCH"
            headers = bowtie.client.jsonAuthHeaders(accessToken)
            body = FormatJson({ "protected": (params.keep = true) })

        else if kind = "recordingRules"
            url = base + "/api/v1/recording-rules"
            method = "GET"
            headers = bowtie.client.authHeaders(accessToken)

        else if kind = "createRecordingRule"
            ' This channel, new episodes only: the server's defaults.
            url = base + "/api/v1/recording-rules"
            method = "POST"
            headers = bowtie.client.jsonAuthHeaders(accessToken)
            body = FormatJson({
                "channelId": params.channelId
                "programStart": params.programStart
            })

        else if kind = "deleteRecordingRule"
            url = base + "/api/v1/recording-rules/" + bowtie.client.idString(params.id)
            method = "DELETE"
            headers = bowtie.client.authHeaders(accessToken)

        else if kind = "createSession"
            url = base + "/api/v1/sessions"
            method = "POST"
            headers = bowtie.client.authHeaders(accessToken)
            headers["Content-Type"] = "application/json"
            caps = params.caps
            if caps = invalid then caps = {}
            body = FormatJson({
                "channelId": params.channelId
                "caps": {
                    "videoCodecs": caps.videoCodecs
                    "audioCodecs": caps.audioCodecs
                    "maxHeight": caps.maxHeight
                    "profile": caps.profile
                }
            })

        else if kind = "deleteSession"
            viewerId = params.viewerId
            if viewerId = invalid then viewerId = ""
            url = base + "/api/v1/sessions/" + viewerId
            method = "DELETE"
            headers = bowtie.client.authHeaders(accessToken)

        else if kind = "heartbeat"
            ' Spec C: stream token query only — never Bearer (avoids refresh races).
            viewerId = params.viewerId
            if viewerId = invalid then viewerId = ""
            token = params.token
            if token = invalid then token = ""
            url = base + "/api/v1/sessions/" + viewerId + "/heartbeat?token=" + token
            method = "POST"
            headers = { "Content-Type": "application/json" }
            body = ""

        else
            return {
                url: ""
                method: "GET"
                headers: {}
                body: ""
                timeoutMs: timeoutMs
                error: "unknown kind: " + kind
            }
        end if

        return {
            url: url
            method: method
            headers: headers
            body: body
            timeoutMs: timeoutMs
        }
    end function

    ' parseResponse(kind, httpCode, body, baseUrl?)
    ' baseUrl is required for createSession absolute playlistUrl (A4).
    function parseResponse(kind as string, httpCode as integer, body as string, baseUrl = "" as string) as object
        if body = invalid then body = ""

        if kind = "healthz"
            if httpCode = 200
                return { ok: true, data: true }
            end if
            return { ok: false, error: { code: httpCode, message: "healthz failed" } }
        end if

        if kind = "logout" or kind = "changePassword" or kind = "deleteSession" or kind = "heartbeat" or kind = "setFavorite" or kind = "deleteRecording" or kind = "stopRecording" or kind = "setRecordingPosition" or kind = "deleteRecordingRule"
            ' Best-effort: 2xx and empty bodies are success; delete swallows errors at ApiTask.
            if httpCode >= 200 and httpCode < 300
                return { ok: true, data: true }
            end if
            if kind = "deleteSession"
                return { ok: true, data: true } ' swallow
            end if
            return {
                ok: false
                error: bowtie.client.mapError(httpCode, body)
            }
        end if

        if httpCode = 401
            return {
                ok: false
                error: { code: 401, kind: "unauthorized", message: bowtie.client.extractError(body) }
            }
        end if

        if kind = "createSession" and httpCode = 503
            return bowtie.client.parseTunersBusy(body)
        end if

        if kind = "createRecording" and httpCode = 409
            return bowtie.client.parseRecordingConflict(body)
        end if

        if kind = "deviceToken" and httpCode = 428
            return { ok: false, error: { code: 428, kind: "pending", message: bowtie.client.extractError(body) } }
        end if
        if kind = "deviceToken" and httpCode = 410
            return { ok: false, error: { code: 410, kind: "expired", message: bowtie.client.extractError(body) } }
        end if

        if kind = "createSession" and httpCode = 422
            msg = bowtie.client.extractError(body)
            if msg = "" then msg = "negotiation failed"
            return {
                ok: false
                error: { code: 422, kind: "negotiation", message: msg }
            }
        end if

        if httpCode = 404
            return {
                ok: false
                error: { code: 404, kind: "notFound", message: bowtie.client.extractError(body) }
            }
        end if

        if httpCode < 200 or httpCode >= 300
            return {
                ok: false
                error: bowtie.client.mapError(httpCode, body)
            }
        end if

        ' Success path
        if kind = "login" or kind = "refresh" or kind = "deviceToken"
            return bowtie.client.parseTokenResponse(body)
        end if

        if kind = "deviceStart"
            return bowtie.client.parseDeviceStart(body, baseUrl)
        end if

        if kind = "me"
            return bowtie.client.parseUser(body)
        end if

        if kind = "channels" or kind = "guide" or kind = "recents"
            parsed = ParseJson(body)
            if parsed = invalid
                return { ok: false, error: { code: httpCode, message: "invalid json" } }
            end if
            return { ok: true, data: parsed }
        end if

        if kind = "createSession"
            return bowtie.client.parseCreatedSession(body, baseUrl)
        end if

        if kind = "playRecording"
            return bowtie.client.parseRecordingPlay(body, baseUrl)
        end if

        parsed = ParseJson(body)
        if parsed = invalid and body <> ""
            return { ok: false, error: { code: httpCode, message: "invalid json" } }
        end if
        return { ok: true, data: parsed }
    end function

    function parseTokenResponse(body as string) as object
        parsed = ParseJson(body)
        if parsed = invalid
            return { ok: false, error: { code: 200, message: "invalid token response" } }
        end if
        user = parsed.user
        if user = invalid
            return { ok: false, error: { code: 200, message: "token response missing user" } }
        end if
        ' Surface maxQuality on user (A1).
        maxQ = user.maxQuality
        if maxQ = invalid then maxQ = ""
        data = {
            accessToken: parsed.accessToken
            refreshToken: parsed.refreshToken
            user: {
                id: user.id
                username: user.username
                role: user.role
                maxQuality: maxQ
            }
        }
        return { ok: true, data: data }
    end function

    function parseUser(body as string) as object
        parsed = ParseJson(body)
        if parsed = invalid
            return { ok: false, error: { code: 200, message: "invalid user response" } }
        end if
        maxQ = parsed.maxQuality
        if maxQ = invalid then maxQ = ""
        return {
            ok: true
            data: {
                id: parsed.id
                username: parsed.username
                role: parsed.role
                maxQuality: maxQ
            }
        }
    end function

    function parseCreatedSession(body as string, baseUrl as string) as object
        parsed = ParseJson(body)
        if parsed = invalid
            return { ok: false, error: { code: 200, message: "invalid session response" } }
        end if
        playlistUrl = parsed.playlistUrl
        if playlistUrl = invalid then playlistUrl = ""
        absoluteUrl = bowtie.client.resolveUrl(playlistUrl, baseUrl)
        data = {
            viewerId: parsed.viewerId
            playlistUrl: absoluteUrl
        }
        if parsed.session <> invalid
            data.session = parsed.session
        end if
        return { ok: true, data: data }
    end function

    ' POST /auth/device → codes, with the server-relative qrUrl made absolute.
    function parseDeviceStart(body as string, baseUrl as string) as object
        parsed = ParseJson(body)
        if parsed = invalid or Type(parsed) <> "roAssociativeArray"
            return { ok: false, error: { code: 200, message: "invalid sign-in code response" } }
        end if
        qrUrl = parsed.qrUrl
        if qrUrl = invalid then qrUrl = ""
        verifyUrl = parsed.verifyUrl
        if verifyUrl = invalid then verifyUrl = ""
        expiresIn = parsed.expiresIn
        if expiresIn = invalid then expiresIn = 0
        interval = parsed.interval
        if interval = invalid then interval = 0
        return {
            ok: true
            data: {
                "deviceCode": bowtie.client.idString(parsed.deviceCode)
                "userCode": bowtie.client.idString(parsed.userCode)
                "verifyUrl": verifyUrl
                "qrUrl": bowtie.client.resolveUrl(qrUrl, baseUrl)
                "expiresIn": expiresIn
                "interval": interval
            }
        }
    end function

    ' 409 from createRecording →{ kind: "conflict", message, tunerCount, conflicts }.
    ' Quoted keys keep their case for callers that serialize the error.
    function parseRecordingConflict(body as string) as object
        parsed = ParseJson(body)
        message = ""
        tunerCount = 0
        conflicts = []
        if parsed <> invalid and Type(parsed) = "roAssociativeArray"
            if parsed.error <> invalid then message = parsed.error
            if parsed.tunerCount <> invalid then tunerCount = parsed.tunerCount
            if parsed.conflicts <> invalid and Type(parsed.conflicts) = "roArray" then conflicts = parsed.conflicts
        end if
        return {
            ok: false
            error: {
                "code": 409
                "kind": "conflict"
                "message": message
                "tunerCount": tunerCount
                "conflicts": conflicts
            }
        }
    end function

    ' POST /recordings/{id}/play → absolute playlistUrl (the server sends a path).
    function parseRecordingPlay(body as string, baseUrl as string) as object
        parsed = ParseJson(body)
        if parsed = invalid or Type(parsed) <> "roAssociativeArray"
            return { ok: false, error: { code: 200, message: "invalid play response" } }
        end if
        playlistUrl = parsed.playlistUrl
        if playlistUrl = invalid then playlistUrl = ""
        positionSec = parsed.positionSec
        if positionSec = invalid then positionSec = 0
        durationSec = parsed.durationSec
        if durationSec = invalid then durationSec = 0
        return {
            ok: true
            data: {
                "playlistUrl": bowtie.client.resolveUrl(playlistUrl, baseUrl)
                "positionSec": positionSec
                "durationSec": durationSec
            }
        }
    end function

    function recordingUrl(base as string, id as dynamic, suffix as string) as string
        return base + "/api/v1/recordings/" + bowtie.client.idString(id) + suffix
    end function

    function parseTunersBusy(body as string) as object
        parsed = ParseJson(body)
        sessions = []
        message = "all tuners in use"
        if parsed <> invalid
            if parsed.error <> invalid then message = parsed.error
            if parsed.sessions <> invalid
                for each s in parsed.sessions
                    channelName = ""
                    if s.channelName <> invalid then channelName = s.channelName
                    viewers = []
                    if s.viewers <> invalid
                        for each v in s.viewers
                            uname = ""
                            if v.username <> invalid then uname = v.username
                            viewers.push({ username: uname })
                        end for
                    end if
                    sessions.push({
                        channelName: channelName
                        viewers: viewers
                    })
                end for
            end if
        end if
        return {
            ok: false
            error: {
                code: 503
                kind: "tunersBusy"
                message: message
                sessions: sessions
            }
        }
    end function

    ' Parental controls answer 403 {"error", "code": "parental"} (session
    ' start, recording play, a stopped viewer's heartbeat) → kind "parental".
    function mapError(httpCode as integer, body as string) as object
        kind = "server"
        if httpCode = 403 and body <> invalid and body <> ""
            parsed = ParseJson(body)
            if parsed <> invalid and Type(parsed) = "roAssociativeArray" and bowtie.client.isString(parsed.code, "parental") then kind = "parental"
        end if
        return {
            code: httpCode
            kind: kind
            message: bowtie.client.extractError(body)
        }
    end function

    function isParental(err as dynamic) as boolean
        if err = invalid or Type(err) <> "roAssociativeArray" then return false
        return bowtie.client.isString(err.kind, "parental")
    end function

    ' v is a string equal to s (false for invalid / other types, no mismatch).
    function isString(v as dynamic, s as string) as boolean
        if v = invalid then return false
        t = Type(v)
        if t <> "String" and t <> "roString" then return false
        return v = s
    end function

    function extractError(body as string) as string
        if body = invalid or body = "" then return ""
        parsed = ParseJson(body)
        if parsed <> invalid and parsed.error <> invalid
            return parsed.error
        end if
        return body
    end function

    ' Integer/LongInteger/string id → path segment.
    function idString(v as dynamic) as string
        if v = invalid then return ""
        t = Type(v)
        if t = "String" or t = "roString" then return v
        return v.toStr()
    end function

    function authHeaders(accessToken as string) as object
        headers = {}
        if accessToken <> invalid and accessToken <> ""
            headers["Authorization"] = "Bearer " + accessToken
        end if
        return headers
    end function

    function jsonAuthHeaders(accessToken as string) as object
        headers = bowtie.client.authHeaders(accessToken)
        headers["Content-Type"] = "application/json"
        return headers
    end function

    ' Strip trailing slash from base URL.
    function normalizeBase(baseUrl as string) as string
        if baseUrl = invalid then return ""
        b = baseUrl
        while Len(b) > 0 and Right(b, 1) = "/"
            b = Left(b, Len(b) - 1)
        end while
        return b
    end function

    ' Resolve relative path (preserving query) against base. Absolute URLs pass through.
    function resolveUrl(pathOrUrl as string, baseUrl as string) as string
        if pathOrUrl = invalid or pathOrUrl = "" then return ""
        ' Already absolute
        if Left(pathOrUrl, 7) = "http://" or Left(pathOrUrl, 8) = "https://"
            return pathOrUrl
        end if
        base = bowtie.client.normalizeBase(baseUrl)
        if Left(pathOrUrl, 1) = "/"
            return base + pathOrUrl
        end if
        return base + "/" + pathOrUrl
    end function

end namespace
