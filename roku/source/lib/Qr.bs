' QR code encoder (ISO/IEC 18004): byte mode, error correction level M,
' versions 1-6 (up to 106 bytes). The Roku has no QR renderer, so the TV
' pairing screen draws the matrix itself from runs().
'
' Pure: encode(text) returns { size, rows } where rows[r][c] = true is a dark
' module, or invalid when the text is too long. Galois-field tables are built
' once per encode and passed down (BrightScript has no module-level state).

namespace bowtie.qr

    ' Per version (index 0 = version 1): size, total data codewords, EC
    ' codewords per block, block count, alignment centers.
    function versions() as object
        return [
            { size: 21, data: 16, ec: 10, blocks: 1, align: [] }
            { size: 25, data: 28, ec: 16, blocks: 1, align: [6, 18] }
            { size: 29, data: 44, ec: 26, blocks: 1, align: [6, 22] }
            { size: 33, data: 64, ec: 18, blocks: 2, align: [6, 26] }
            { size: 37, data: 86, ec: 24, blocks: 2, align: [6, 30] }
            { size: 41, data: 108, ec: 16, blocks: 4, align: [6, 34] }
        ]
    end function

    ' Smallest version (1-6) whose byte capacity holds n bytes, or 0.
    function capacityVersion(n as integer) as integer
        v = 1
        for each info in bowtie.qr.versions()
            if info.data - 2 >= n then return v
            v = v + 1
        end for
        return 0
    end function

    function xor(a as integer, b as integer) as integer
        return (a or b) and not (a and b)
    end function

    ' GF(256) with primitive polynomial 0x11D: { exp: [0..254], log: [0..255] }.
    function gfTables() as object
        expT = []
        logT = []
        for i = 0 to 255
            logT.push(0)
        end for
        x = 1
        for i = 0 to 254
            expT.push(x)
            logT[x] = i
            x = x << 1
            if (x and &h100) <> 0 then x = bowtie.qr.xor(x, &h11D)
        end for
        return { exp: expT, log: logT }
    end function

    function gfMul(a as integer, b as integer, gf as object) as integer
        if a = 0 or b = 0 then return 0
        return gf.exp[(gf.log[a] + gf.log[b]) mod 255]
    end function

    ' Mode, length, bytes, terminator and padding, as data codewords.
    function dataCodewords(bytes as object, version as integer) as object
        total = bowtie.qr.versions()[version - 1].data
        bits = []
        bowtie.qr.pushBits(bits, 4, 4)
        bowtie.qr.pushBits(bits, bytes.Count(), 8)
        for each b in bytes
            bowtie.qr.pushBits(bits, b, 8)
        end for
        capacity = total * 8
        term = capacity - bits.Count()
        if term > 4 then term = 4
        bowtie.qr.pushBits(bits, 0, term)
        while (bits.Count() mod 8) <> 0
            bits.push(0)
        end while
        words = []
        for i = 0 to bits.Count() - 1 step 8
            w = 0
            for j = 0 to 7
                w = (w << 1) or bits[i + j]
            end for
            words.push(w)
        end for
        pad = &hEC
        while words.Count() < total
            words.push(pad)
            if pad = &hEC then pad = &h11 else pad = &hEC
        end while
        return words
    end function

    ' Appends the low `count` bits of value, most significant first.
    sub pushBits(bits as object, value as integer, count as integer)
        for i = count - 1 to 0 step -1
            bits.push((value >> i) and 1)
        end for
    end sub

    ' Reed-Solomon EC codewords for data: generator prod(x - a^i), i < ecLen.
    function rsRemainder(data as object, ecLen as integer, gf as object) as object
        divisor = []
        for i = 1 to ecLen
            divisor.push(0)
        end for
        divisor[ecLen - 1] = 1
        root = 1
        for i = 0 to ecLen - 1
            for j = 0 to ecLen - 1
                divisor[j] = bowtie.qr.gfMul(divisor[j], root, gf)
                if j + 1 < ecLen then divisor[j] = bowtie.qr.xor(divisor[j], divisor[j + 1])
            end for
            root = bowtie.qr.gfMul(root, 2, gf)
        end for

        result = []
        for i = 1 to ecLen
            result.push(0)
        end for
        for each b in data
            factor = bowtie.qr.xor(b, result.Shift())
            result.push(0)
            for j = 0 to ecLen - 1
                result[j] = bowtie.qr.xor(result[j], bowtie.qr.gfMul(divisor[j], factor, gf))
            end for
        end for
        return result
    end function

    ' Splits data into equal blocks, adds EC, and interleaves column-wise:
    ' all data codewords first, then all EC codewords.
    function interleave(words as object, version as integer, gf as object) as object
        info = bowtie.qr.versions()[version - 1]
        per = info.data \ info.blocks
        dataBlocks = []
        ecBlocks = []
        for b = 0 to info.blocks - 1
            block = []
            for i = 0 to per - 1
                block.push(words[b * per + i])
            end for
            dataBlocks.push(block)
            ecBlocks.push(bowtie.qr.rsRemainder(block, info.ec, gf))
        end for
        result = []
        for i = 0 to per - 1
            for each block in dataBlocks
                result.push(block[i])
            end for
        end for
        for i = 0 to info.ec - 1
            for each block in ecBlocks
                result.push(block[i])
            end for
        end for
        return result
    end function

    ' Function patterns for a version: { size, dark, fn } where fn marks every
    ' module that is not data (finders, separators, timing, alignment, dark
    ' module, format areas).
    function newMatrix(version as integer) as object
        info = bowtie.qr.versions()[version - 1]
        size = info.size
        dark = []
        fn = []
        for r = 0 to size - 1
            dRow = []
            fRow = []
            for c = 0 to size - 1
                dRow.push(false)
                fRow.push(false)
            end for
            dark.push(dRow)
            fn.push(fRow)
        end for
        mx = { size: size, dark: dark, fn: fn }

        for i = 0 to size - 1
            bowtie.qr.setFn(mx, 6, i, (i mod 2) = 0)
            bowtie.qr.setFn(mx, i, 6, (i mod 2) = 0)
        end for

        ' Finders with their white separators.
        centers = [[3, 3], [3, size - 4], [size - 4, 3]]
        for each ctr in centers
            for dr = -4 to 4
                for dc = -4 to 4
                    r = ctr[0] + dr
                    c = ctr[1] + dc
                    if r >= 0 and r < size and c >= 0 and c < size
                        dist = bowtie.qr.maxAbs(dr, dc)
                        bowtie.qr.setFn(mx, r, c, dist <> 2 and dist <> 4)
                    end if
                end for
            end for
        end for

        ' Alignment patterns at every center pair not under a finder.
        n = info.align.Count()
        for i = 0 to n - 1
            for j = 0 to n - 1
                corner = (i = 0 and j = 0) or (i = 0 and j = n - 1) or (i = n - 1 and j = 0)
                if not corner
                    for dr = -2 to 2
                        for dc = -2 to 2
                            bowtie.qr.setFn(mx, info.align[i] + dr, info.align[j] + dc, bowtie.qr.maxAbs(dr, dc) <> 1)
                        end for
                    end for
                end if
            end for
        end for

        ' Reserve both format areas (and set the dark module) with mask 0;
        ' writeFormat overwrites them with the chosen mask.
        bowtie.qr.writeFormat(mx, 0)
        return mx
    end function

    function maxAbs(a as integer, b as integer) as integer
        if a < 0 then a = -a
        if b < 0 then b = -b
        if a > b then return a
        return b
    end function

    sub setFn(mx as object, r as integer, c as integer, isDark as boolean)
        mx.dark[r][c] = isDark
        mx.fn[r][c] = true
    end sub

    ' Data and EC codewords in the zig-zag: two-column strips from the right,
    ' skipping the timing column, alternating up and down, MSB first.
    sub placeData(mx as object, codewords as object)
        size = mx.size
        total = codewords.Count() * 8
        i = 0
        right = size - 1
        while right >= 1
            if right = 6 then right = 5
            upward = ((right + 1) and 2) = 0
            for vert = 0 to size - 1
                if upward then r = size - 1 - vert else r = vert
                for j = 0 to 1
                    c = right - j
                    if not mx.fn[r][c] and i < total
                        mx.dark[r][c] = ((codewords[i >> 3] >> (7 - (i and 7))) and 1) = 1
                        i = i + 1
                    end if
                end for
            end for
            right = right - 2
        end while
    end sub

    ' A copy of the matrix with mask k applied to the data modules.
    function applyMask(mx as object, k as integer) as object
        size = mx.size
        rows = []
        for r = 0 to size - 1
            src = mx.dark[r]
            fnRow = mx.fn[r]
            row = []
            for c = 0 to size - 1
                v = src[c]
                if not fnRow[c] and bowtie.qr.maskHit(k, r, c) then v = not v
                row.push(v)
            end for
            rows.push(row)
        end for
        return { size: size, dark: rows, fn: mx.fn }
    end function

    function maskHit(k as integer, r as integer, c as integer) as boolean
        if k = 0 then return ((r + c) mod 2) = 0
        if k = 1 then return (r mod 2) = 0
        if k = 2 then return (c mod 3) = 0
        if k = 3 then return ((r + c) mod 3) = 0
        if k = 4 then return ((r \ 2 + c \ 3) mod 2) = 0
        p = r * c
        if k = 5 then return ((p mod 2) + (p mod 3)) = 0
        if k = 6 then return (((p mod 2) + (p mod 3)) mod 2) = 0
        return ((((r + c) mod 2) + (p mod 3)) mod 2) = 0
    end function

    ' Format information for level M and the mask, both copies, plus the
    ' dark module at (4V+9, 8).
    sub writeFormat(mx as object, mask as integer)
        data = mask ' level M is 00
        remBits = data
        for i = 1 to 10
            remBits = bowtie.qr.xor(remBits << 1, ((remBits >> 9) and 1) * &h537)
        end for
        bits = bowtie.qr.xor((data << 10) or remBits, &h5412)
        size = mx.size

        for i = 0 to 5
            bowtie.qr.setFn(mx, i, 8, bowtie.qr.bit(bits, i))
        end for
        bowtie.qr.setFn(mx, 7, 8, bowtie.qr.bit(bits, 6))
        bowtie.qr.setFn(mx, 8, 8, bowtie.qr.bit(bits, 7))
        bowtie.qr.setFn(mx, 8, 7, bowtie.qr.bit(bits, 8))
        for i = 9 to 14
            bowtie.qr.setFn(mx, 8, 14 - i, bowtie.qr.bit(bits, i))
        end for

        for i = 0 to 7
            bowtie.qr.setFn(mx, 8, size - 1 - i, bowtie.qr.bit(bits, i))
        end for
        for i = 8 to 14
            bowtie.qr.setFn(mx, size - 15 + i, 8, bowtie.qr.bit(bits, i))
        end for
        bowtie.qr.setFn(mx, size - 8, 8, true)
    end sub

    function bit(x as integer, i as integer) as boolean
        return ((x >> i) and 1) = 1
    end function

    ' Mask penalty: N1 runs of 5+ (3 + extra), N2 2x2 blocks (3), N3 finder-like
    ' 1:1:3:1:1 with 4 light on a side (40), N4 dark balance (10 per 5%).
    function penalty(mx as object) as integer
        size = mx.size
        g = mx.dark
        score = 0
        darkCount = 0
        for r = 0 to size - 1
            row = g[r]
            col = []
            for c = 0 to size - 1
                col.push(g[c][r])
                if row[c] then darkCount = darkCount + 1
            end for
            score = score + bowtie.qr.linePenalty(row) + bowtie.qr.linePenalty(col)
        end for
        for r = 0 to size - 2
            top = g[r]
            bottom = g[r + 1]
            for c = 0 to size - 2
                v = top[c]
                if top[c + 1] = v and bottom[c] = v and bottom[c + 1] = v then score = score + 3
            end for
        end for
        total = size * size
        dev = darkCount * 20 - total * 10
        if dev < 0 then dev = -dev
        score = score + (dev \ total) * 10
        return score
    end function

    ' N1 and N3 for one row or column.
    function linePenalty(line as object) as integer
        n = line.Count()
        score = 0
        runLen = 1
        for i = 1 to n
            if i < n and line[i] = line[i - 1]
                runLen = runLen + 1
            else
                if runLen >= 5 then score = score + 3 + (runLen - 5)
                runLen = 1
            end if
        end for
        for i = 0 to n - 7
            if line[i] and not line[i + 1] and line[i + 2] and line[i + 3] and line[i + 4] and not line[i + 5] and line[i + 6]
                if bowtie.qr.lightSpan(line, i - 4, i - 1) or bowtie.qr.lightSpan(line, i + 7, i + 10)
                    score = score + 40
                end if
            end if
        end for
        return score
    end function

    ' True when every module in [first, last] is light (outside counts as light).
    function lightSpan(line as object, first as integer, last as integer) as boolean
        n = line.Count()
        for i = first to last
            if i >= 0 and i < n and line[i] then return false
        end for
        return true
    end function

    ' The QR matrix for text (UTF-8, byte mode, level M), or invalid when it
    ' is longer than 106 bytes.
    function encode(text as string) as dynamic
        ba = CreateObject("roByteArray")
        ba.FromAsciiString(text)
        bytes = []
        for each b in ba
            bytes.push(b)
        end for
        version = bowtie.qr.capacityVersion(bytes.Count())
        if version = 0 then return invalid

        gf = bowtie.qr.gfTables()
        codewords = bowtie.qr.interleave(bowtie.qr.dataCodewords(bytes, version), version, gf)
        base = bowtie.qr.newMatrix(version)
        bowtie.qr.placeData(base, codewords)

        best = invalid
        bestScore = 0
        for k = 0 to 7
            candidate = bowtie.qr.applyMask(base, k)
            bowtie.qr.writeFormat(candidate, k)
            s = bowtie.qr.penalty(candidate)
            if best = invalid or s < bestScore
                best = candidate
                bestScore = s
            end if
        end for
        return { size: best.size, rows: best.dark }
    end function

    ' Horizontal runs of dark modules, for drawing: [{ x, y, w }] in modules.
    function runs(matrix as object) as object
        list = []
        for y = 0 to matrix.size - 1
            row = matrix.rows[y]
            x = 0
            while x < matrix.size
                if row[x]
                    start = x
                    while x < matrix.size and row[x]
                        x = x + 1
                    end while
                    list.push({ x: start, y: y, w: x - start })
                else
                    x = x + 1
                end if
            end while
        end for
        return list
    end function

end namespace
